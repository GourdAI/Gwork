<script setup>
	import { initTheme } from '@/hooks/useTheme'
	import { initLocale } from '@/hooks/useLocale'
	import { initViewport } from '@/hooks/useViewport'
	import { gworkRestore, gworkRefresh, gworkSessionSnapshot } from '@/utils/gwork-auth.ts'
	import { refreshUserFromAccount } from '@/hooks/useUser'

	// #ifdef APP-ANDROID || APP-HARMONY
	let firstBackTime = 0
	// #endif

	onLaunch(() => {
		console.log('App Launch')
		uni.loadFontFace({
            global: true,
            family: 'iconfont',
            source: "url('/static/iconfont/iconfont.ttf')"
        })
		// 主题必须在首帧前恢复，否则会先按默认亮色渲染再跳变
		initTheme()
		initLocale()
		// 视口尺寸同样要在首帧前就绪：横屏/平板冷启动时首页直接按双栏渲染，避免先窄后宽跳变
		initViewport()
		// 会话恢复走异步：登录页 onShow 检查 signedIn 决定是否直接进首页
		gworkRestore().then((ok: boolean): void => {
			if (ok) refreshUserFromAccount()
		}, (): void => { })
	})

	onAppShow(() => {
		console.log('App Show')
		// 移动端切后台很久再回来：access token 大概率已过期，有会话时补一次保活刷新。
		// 不用 gworkRestore（它会重读 storage，可能覆盖内存里刚登录的新会话）
		if (gworkSessionSnapshot() != null) {
			gworkRefresh().then((_s): void => { }, (): void => { })
		}
	})

	onAppHide(() => {
		console.log('App Hide')
	})

	// #ifdef APP-ANDROID || APP-HARMONY
	onLastPageBackPress(() => {
		console.log('App LastPageBackPress')
		if (firstBackTime == 0) {
			uni.showToast({
				title: '再按一次退出应用',
				position: 'bottom',
			})
			firstBackTime = Date.now()
			setTimeout(() => {
				firstBackTime = 0
			}, 2000)
		} else if (Date.now() - firstBackTime < 2000) {
			firstBackTime = Date.now()
			uni.exit()
		}
	})

	onExit(() => {
		console.log('App Exit')
	})
	// #endif
</script>

<style>
	/* rice-ui 的组件颜色全部取自 var(--rice-*)，样式入口必须全局引入一次，否则变量全是未定义状态。
	   按 rice-ui readme 用纯 css 块引入；H5 + 样式隔离 2.0 另在 main.ts 引入一份。 */
	@import "@/uni_modules/rice-ui/libs/style/index.css";
</style>

<style lang="scss">
	/* 自有页面/组件的主题变量，放在 rice-ui 之后，必要时可覆盖其同名变量 */
	@import '@/styles/theme.scss';
	/* APP 端 UCSS 不支持 :before 伪类选择器，iconfont.css 的码点规则（.icon-xxx:before）会编译报错；
	   APP 端字体由 onLaunch 的 uni.loadFontFace 注册、码点直接写在 text 内容里，只需 .iconfont 基础规则；
	   完整码点表（:before content）仅 Web 端引入 */
	// #ifdef WEB
	@import '@/static/iconfont/iconfont.css';
	// #endif

	.iconfont {
		font-family: iconfont;
		font-size: 16px;
		font-style: normal;
	}

	/* 页面容器背景：转场动画第一帧就开始绘制，页面根节点的 themeClass 晚于它生效，
	   只靠页面内的 CSS 会在滑入时露出默认白色容器。page 选择器 + 媒体查询是官方支持的
	   全页面批量控制方式，颜色仍取自 $theme-palette。 */
	page {
		background-color: map-get($theme-palette, 'light', 'bg');
	}

	@media (prefers-color-scheme: dark) {
		page {
			background-color: map-get($theme-palette, 'dark', 'bg');
		}
	}

	/*每个页面公共css */
	.uni-row {
		flex-direction: row;
	}

	.uni-column {
		flex-direction: column;
	}
</style>