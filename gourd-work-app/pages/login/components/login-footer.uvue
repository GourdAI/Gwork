<template>
	<view class="login-footer">
		<view class="login-footer__pill">
			<rice-button type="default" plain shape="round" height="40px" @click="emit('enterprise')">
				<view class="login-footer__icon">
					<text class="iconfont login-footer__icon-glyph">&#xe60f;</text>
				</view>
				<text class="login-footer__text">{{ t('login.enterpriseLogin') }}</text>
			</rice-button>
