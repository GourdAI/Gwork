<template>
	<rice-code-input v-model="code" :maxlength="length" mode="box" size="46px" space="9px" justify-content="center"
		:bold="true" :font-size="22" :show-cursor="false" :border-color="boxBorderColor" bg-color="var(--color-bg-card)"
		color="var(--color-text)" custom-style="width: 100%;" @change="onChange" @finish="onFinish" @focus="onFocus"
		@blur="onBlur"></rice-code-input>
</template>

<script setup lang="ts">
	import { computed, ref, watch } from 'vue'
	import type { ComputedRef } from 'vue'

	const props = defineProps<{
		modelValue: string
		length: number
	}>()

	const emit = defineEmits<{
		(e: 'update:modelValue', value: string): void
		(e: 'complete', value: string): void
	}>()

	const focused = ref<boolean>(false)
	// rice 的 finish 在满码后每次输入事件都会再发，保留一次完成态避免重复跳转；删字符后重新可触发
	const completed = ref<boolean>(false)

	const code: ComputedRef<string> = computed<string>((): string => props.modelValue)

	// 聚焦时描边用主色，还原原组件的 active 分格样式
	const boxBorderColor: ComputedRef<string> = computed<string>((): string => {
		return focused.value ? 'var(--color-primary)' : 'var(--color-border)'
	})

	// 清空验证码（如重新发送）后恢复可完成态
	watch((): string => props.modelValue, (value: string): void => {
		if (value.length < props.length) completed.value = false
	})

	function onChange(value: string): void {
		// rice-code-input 不做数字过滤，这里保持原组件「只留数字、截断到 length」的行为
		const digits: string = value.replace(/\D/g, '').substring(0, props.length)
		// 回写清洗后的值，rice 内部 watch modelValue 会同步分格显示
		emit('update:modelValue', digits)
		if (digits.length < props.length) completed.value = false
	}

	function onFinish(value: string): void {
		if (value.length < props.length) return
		if (completed.value) return
		completed.value = true
		emit('complete', value)
	}

	function onFocus(): void {
		focused.value = true
	}

	function onBlur(): void {
		focused.value = false
	}
</script>
