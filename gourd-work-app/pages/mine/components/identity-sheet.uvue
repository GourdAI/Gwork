<template>
	<!-- 切换账号弹层：个人账号卡 + 企业账号卡列表，选中卡高亮；受阻企业由页面弹提示 -->
	<app-sheet :visible="visible" :title="t('mine.switchAccount')" :tall="true" @close="emit('close')">
		<view class="acct-list">
			<view v-for="(item, index) in rows" :key="item.key" class="acct-card"
				:class="[item.current ? 'acct-card--on' : '', item.personal ? 'acct-card--personal' : '', index < rows.length - 1 ? 'acct-card--divided' : '']"
				@click="emit('select', item.key)">
				<!-- rice-avatar 的 round 在非 Android 端不生效（radius 默认 null），必须显式传 radius -->
				<rice-avatar v-if="item.personal" :src="avatar" size="44px" mode="aspectFill" radius="22px"></rice-avatar>
				<view v-else class="acct-card__ic">
					<text class="iconfont acct-card__ic-glyph">&#xe60f;</text>
				</view>
				<view class="acct-card__tx">
					<view class="acct-card__l1">
						<text class="acct-card__name">{{ item.name }}</text>
						<text v-if="item.badge.length > 0" class="acct-card__badge"
							:class="'acct-card__badge--' + item.status">{{ item.badge }}</text>
					</view>
					<view class="acct-card__l2">
						<text class="acct-card__sub">{{ item.sub }}</text>
						<text v-if="item.role.length > 0" class="acct-card__badge acct-card__badge--role">{{ item.role }}</text>
					</view>
				</view>
				<rice-icon name="arrow-right" size="16px" color="var(--color-text-tertiary)"></rice-icon>
			</view>
		</view>
	</app-sheet>
</template>

<script setup lang="ts">
	import { computed } from 'vue'
	import type { ComputedRef } from 'vue'
	import { i18n } from '@/locale/i18n.ts'
	import { useUser } from '@/hooks/useUser'
	import { ENTERPRISES } from '@/data/app-data'
	import type { EnterpriseStatus } from '@/data/app-data'
	import AppSheet from '@/components/app-sheet/app-sheet.uvue'

	defineOptions({
		name: 'identity-sheet',
		styleIsolation: 'app-and-page'
	})

	type IdentityRow = {
		key: string
		name: string
		personal: boolean
		sub: string
		badge: string
		role: string
		status: EnterpriseStatus
		current: boolean
	}

	withDefaults(defineProps<{
		visible: boolean
	}>(), {
		visible: false
	})

	const emit = defineEmits<{
		(e: 'close'): void
		/** 个人卡传 'personal'，企业卡传企业名 */
		(e: 'select', key: string): void
	}>()

	const { name, avatar, idType, enterprise } = useUser()

	function t(key: string): string {
		return i18n.global.t(key)
	}

	function statusBadge(status: EnterpriseStatus): string {
		if (status === 'ok') return t('mine.entVerified')
		if (status === 'pending') return t('mine.entPending')
		return t('mine.entUnverified')
	}

	const rows: ComputedRef<IdentityRow[]> = computed<IdentityRow[]>((): IdentityRow[] => {
		const list: IdentityRow[] = [{
			key: 'personal',
			name: name.value,
			personal: true,
			sub: t('mine.personalAccount'),
			badge: '',
			role: '',
			status: 'ok',
			current: idType.value === 'personal'
		}]
		ENTERPRISES.forEach((item): void => {
			list.push({
				key: item.name,
				name: item.name,
				personal: false,
				sub: t('settings.nameLabelEnt') + '：' + name.value,
				badge: statusBadge(item.status),
				role: item.role,
				status: item.status,
				current: idType.value === 'enterprise' && enterprise.value === item.name
			})
		})
		return list
	})
</script>

<style lang="scss">
	.acct-list {
		border-width: 1px;
		border-style: solid;
		border-color: var(--color-border);
		border-radius: 18px;
		background-color: var(--color-bg-card);
		overflow: hidden;
	}

	.acct-card {
		flex-direction: row;
		align-items: center;
		width: 100%;
		padding: 14px 13px;

		&--divided {
			border-bottom-width: 1px;
			border-bottom-style: solid;
			border-bottom-color: var(--color-border);
		}

		&--on {
			background-color: var(--color-brand-soft);
		}

		&__ic {
			width: 44px;
			height: 44px;
			border-radius: 14px;
			align-items: center;
			justify-content: center;
			background-color: var(--color-ent-icon-bg);
		}

		/* 企业图标（iconfont 码点），UCSS 无继承，色与字号需显式声明 */
		&__ic-glyph {
			font-size: 20px;
			color: var(--color-primary);
		}

		&__tx {
			flex: 1;
			min-width: 0;
			flex-direction: column;
			margin-left: 12px;
		}

		&__l1 {
			flex-direction: row;
			align-items: center;
		}

		&__l2 {
			flex-direction: row;
			align-items: center;
			margin-top: 7px;
		}

		&__name {
			font-size: 13.5px;
			font-weight: 750;
			color: var(--color-text);
		}

		&__sub {
			font-size: 12px;
			color: var(--color-text-tertiary);
		}

		&__badge {
			margin-left: 8px;
			font-size: 10.5px;
			font-weight: 700;
			padding: 3px 8px;
			border-radius: 8px;

			&--ok {
				background-color: var(--color-badge-ok-bg);
				color: var(--color-badge-ok);
			}

			&--pending {
				background-color: var(--color-badge-pending-bg);
				color: var(--color-badge-pending);
			}

			&--fail {
				background-color: var(--color-badge-fail-bg);
				color: var(--color-badge-fail);
			}

			&--role {
				background-color: var(--color-brand-soft);
				color: var(--color-primary);
			}
		}
	}
</style>
