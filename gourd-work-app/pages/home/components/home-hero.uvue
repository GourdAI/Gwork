<template>
	<view class="home-hero">
		<image class="home-hero__logo" :src="logoSrc" mode="aspectFit"></image>
		<text class="home-hero__title">{{ greeting }}</text>
		<view class="home-hero__caps">
			<view v-for="cap in CAPS" :key="cap.label" class="home-hero__cap" @click="onCap(cap.prompt)">
				<view class="home-hero__cap-dot"></view>
				<text class="home-hero__cap-text">{{ t(cap.label) }}</text>
			</view>
		</view>
	</view>
</template>

<script setup lang="ts">
	import { computed } from 'vue'
	import type { ComputedRef } from 'vue'
	import { i18n } from '@/locale/i18n.ts'
	import { useTheme } from '@/hooks/useTheme'
	import { pickGreetingIndex, greetingText } from '@/utils/greeting.ts'

	defineOptions({
		name: 'home-hero',
		styleIsolation: 'app-and-page'
	})

	type Capability = {
		label: string
		prompt: string
	}

	const CAPS: Capability[] = [
		{ label: 'home.cap.task', prompt: 'home.cap.taskPrompt' },
		{ label: 'home.cap.continuous', prompt: 'home.cap.continuousPrompt' },
		{ label: 'home.cap.parallel', prompt: 'home.cap.parallelPrompt' }
	]

	const emit = defineEmits<{
		(e: 'fill', text: string): void
	}>()

	const { isDark } = useTheme()

	// logo 与桌面端同源：亮色黑底白 G / 暗色近白底黑 G（与暗色主色近白实底同构）
	const logoSrc: ComputedRef<string> = computed<string>((): string => {
		return isDark.value ? '/static/logo-inverse.png' : '/static/logo.png'
	})

	// 欢迎语：桌面端 20 条标语随机轮换。hero 随「新建会话/冷启动」重新挂载（v-if 切换），
	// 每次挂载抽一条；跨挂载去重在 utils/greeting.ts 模块级实现（setup 作用域会随重建丢失）
	const greetingIndex: number = pickGreetingIndex()

	const greeting: ComputedRef<string> = computed<string>((): string => {
		return greetingText(greetingIndex)
	})

	function t(key: string): string {
		return i18n.global.t(key)
	}

	function onCap(promptKey: string): void {
		emit('fill', t(promptKey))
	}
</script>

<style lang="scss">
	.home-hero {
		flex: 1;
		align-items: center;
		justify-content: center;
		padding: 0 16px 18px;

		&__logo {
			width: 74px;
			height: 74px;
			margin-bottom: 18px;
		}

		&__title {
			font-size: 24px;
			line-height: 34px;
			font-weight: 700;
			letter-spacing: -0.5px;
			text-align: center;
			color: var(--color-hero-title);
		}

		&__caps {
			flex-direction: row;
			flex-wrap: wrap;
			align-items: center;
			justify-content: center;
			margin-top: 30px;
		}

		&__cap {
			flex-direction: row;
			align-items: center;
			margin: 4px 9px;
		}

		&__cap-dot {
			width: 8px;
			height: 8px;
			margin-right: 9px;
			border-radius: 4px;
			background-color: var(--color-cap-dot);
		}

		&__cap-text {
			font-size: 14px;
			font-weight: 500;
			color: var(--color-cap-text);
		}
	}
</style>
