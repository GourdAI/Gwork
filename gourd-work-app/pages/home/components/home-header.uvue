<template>
	<view class="home-header">
		<view v-if="!props.hideMenu" class="home-header__menu" @click="emit('menu')">
			<text class="iconfont">&#xe634;</text>
		</view>
		<text class="home-header__brand" :class="props.hideMenu ? 'home-header__brand--solo' : ''">{{ t('home.brand') }}</text>
		<!-- 头部只展示 设备 | 工作空间；权限入口在运行弹层内（与工作空间同组），不在头部露出 -->
		<app-env-bar class="home-header__env" :device="device" :device-online="deviceOnline" :workspace="workspace"
			@open-run="emit('open-run')"></app-env-bar>
	</view>
</template>

<script setup lang="ts">
	import { i18n } from '@/locale/i18n.ts'
	import AppEnvBar from '@/components/app-env-bar/app-env-bar.uvue'

	defineOptions({
		name: 'home-header',
		styleIsolation: 'app-and-page'
	})

	// 宽屏双栏下侧栏常驻，菜单按钮无意义，由页面传 hide-menu 隐藏
	const props = withDefaults(defineProps<{
		device: string
		deviceOnline: boolean
		workspace: string
		hideMenu?: boolean
	}>(), {
		hideMenu: false
	})

	const emit = defineEmits<{
		(e: 'menu'): void
		(e: 'open-run'): void
	}>()

	function t(key: string): string {
		return i18n.global.t(key)
	}
</script>

<style lang="scss">
	.home-header {
		flex-direction: row;
		align-items: center;
		padding: 8px 14px 0;

		&__menu {
			width: 32px;
			height: 32px;
			align-items: center;
			justify-content: center;
			border-radius: 10px;
		}

		&__brand {
			margin-left: 8px;
			font-size: 17px;
			font-weight: 800;
			letter-spacing: -0.3px;
			color: var(--color-text);

			// 双栏态无菜单按钮，品牌名顶格（与侧栏内容左缘节奏一致）
			&--solo {
				margin-left: 4px;
			}
		}

		&__env {
			margin-left: auto;
		}
	}
</style>
