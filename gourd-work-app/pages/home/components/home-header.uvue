		styleIsolation: 'app-and-page'
	})

	defineProps<{
		device: string
		deviceOnline: boolean
		workspace: string
		permission: string
	}>()

	const emit = defineEmits<{
		(e: 'menu'): void
		(e: 'open-run'): void
	}>()

	function t(key: string): string {
		return i18n.global.t(key)
	}
</script>

