<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
	<!-- Android 11+ 包可见性：没有此声明 queryIntentServices 找不到厂商识别引擎，
		SpeechRecognizer.isRecognitionAvailable 恒 false -->
	<queries>
		<intent>
			<action android:name="android.speech.RecognitionService" />
		</intent>
	</queries>
	<application>
	</application>
</manifest>