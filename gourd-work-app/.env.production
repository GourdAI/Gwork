# 线上环境
VITE_USER_NODE_ENV = production

# 公共基础路径
VITE_PUBLIC_PATH = /

# 路由模式
# Optional: hash | history
VITE_ROUTER_MODE = history

# 是否启用 gzip 或 brotli 压缩打包，如果需要多个压缩规则，可以使用 “,” 分隔
# Optional: gzip | brotli | none
VITE_BUILD_COMPRESS = none

# 打包压缩后是否删除源文件
VITE_BUILD_COMPRESS_DELETE_ORIGIN_FILE = false

# 打包时是否删除 console
VITE_DROP_CONSOLE = true

# 是否开启 VitePWA
VITE_PWA = true

# 线上环境接口地址
VITE_API_PROXY = /api

# 测试
VITE_API_URL = https://hf.rhwx-ai.com:9825/api

# 国际
#VITE_API_URL = https://www.aionly.com/api

# 国内
# VITE_API_URL = https://token.aiionly.com/api"

//websocketUrl
VITE_APP_SOCKET_URL = wss://www.rhwx-ai.com:9820/websocket/

# 魔法app端id
VITE_APP_CLIENT_ID = 6cb70a15461cb1ebc0f353d9b34a4071

# AIOnly 模块配置
VITE_AIONLY_TENANT_ID = 000001
VITE_AIONLY_LOGIN_URL = https://www.aionly.com/
# 请求头 hostname 与模型列表 domain 参数共用
VITE_AIONLY_HOSTNAME = localhost
VITE_AIONLY_REQUEST_TIMEOUT = 20000
VITE_AIONLY_PAGE_SIZE = 100
VITE_AIONLY_MAX_PAGES = 10

# 易晓模块配置（地址与桌面端 YIXIAO_BASE_URL 一致，末尾补 /api）
# H5 线上需由网关把 VITE_YIXIAO_PROXY 前缀转发到 VITE_YIXIAO_BASE_URL
VITE_YIXIAO_BASE_URL = https://yixiao.aionly.com/admin/api
VITE_YIXIAO_PROXY = /yixiao-app
VITE_YIXIAO_REQUEST_TIMEOUT = 20000


# 接口加密功能开关(如需关闭 后端也必须对应关闭)
VITE_APP_ENCRYPT = true
# 接口加密传输 RSA 公钥与后端解密私钥对应 如更换需前后端一同更换
VITE_APP_RSA_PUBLIC_KEY = 'MFwwDQYJKoZIhvcNAQEBBQADSwAwSAJBAKoR8mX0rGKLqzcWmOzbfj64K8ZIgOdHnzkXSOVOZbFu/TJhZ7rFAN+eaGkl3C4buccQd/EjEsj9ir7ijT7h96MCAwEAAQ=='
# 接口响应解密 RSA 私钥与后端加密公钥对应 如更换需前后端一同更换
VITE_APP_RSA_PRIVATE_KEY = ''
