{
	"pages": [ //pages数组中第一项表示应用启动页，参考：https://doc.dcloud.net.cn/uni-app-x/collocation/pagesjson.html
		{
			"path": "pages/login/index"
		},
		{
			"path": "pages/home/index"
		}
	,{
	    "path": "pages/mine/index"
	}
	,{
	    "path": "pages/account-settings/index"
	}
	,{
	    "path": "pages/rebind-email/index"
	}
	,{
    "path": "uni_modules/rice-ui/pages/action-sheet/action-sheet"
}
,{
    "path": "uni_modules/rice-ui/pages/dialog/dialog"
}
],
	"globalStyle": {
		"navigationStyle": "custom",
		// 横屏/平板适配：uni-app x 默认 portrait（锁竖屏），必须显式放开旋转，
		// 否则手机横过来页面纹丝不动；页面内布局由 useViewport 按窗口尺寸自适应
		"pageOrientation": "auto",
		// 导航栏 / 下拉窗口背景由 theme.json 提供亮暗两套值；转场第一帧的页面容器背景见 App.uvue 的 page 规则
		"navigationBarTextStyle": "@navTxtStyle",
		"navigationBarTitleText": "uni-app x",
		"navigationBarBackgroundColor": "@navBgColor",
		"backgroundColor": "@bgColor",
		// iOS 回弹区域背景，跟随主题
		"backgroundColorTop": "@bgColorTop",
		"backgroundColorBottom": "@bgColorBottom"
	},
	"uniIdRouter": {},
	"condition" : { //模式配置，仅开发期间生效
		"current": 0, //当前激活的模式(list 的索引项)
		"list": [
			{
				"name": "", //模式名称
				"path": "", //启动页面，必选
				"query": "" //启动参数，在页面的onLoad函数里面得到
			}
		]
	}
}
