<template>
	<view class="app-chat">
		<view class="app-chat__head">
			<view class="app-chat__row" :style="colStyle">
				<view v-if="!props.hideMenu" class="app-chat__icon" @click="emit('back')">
					<!-- 左上是菜单（转出会话抽屉），不是返回；码点即菜单图标。
						 不能带 icon-caidan1 类名：Web 端引入了 iconfont.css，.icon-caidan1:before 会再补一个字形，与 text 内容重复 -->
					<text class="iconfont app-chat__back">&#xe634;</text>
				</view>
				<view class="app-chat__hd">
					<text class="app-chat__title" @click="onRename">{{ title }}</text>
					<!-- 头部只展示 设备 | 工作空间；权限入口收敛在运行弹层（与工作空间同组） -->
					<app-env-bar class="app-chat__env" :device="device" :device-online="deviceOnline"
						:workspace="convWorkspace"
						@open-run="runSheetVisible = true"></app-env-bar>
				</view>
				<view class="app-chat__icon" @click="onNewChat">
					<rice-icon name="add" :size="18" color="var(--color-text-secondary)"></rice-icon>
				</view>
				<view class="app-chat__icon" @click="menuVisible = true">
					<!-- 字体图标缺 more，先以文本占位，待字体图标补全后替换 -->
					<text class="app-chat__more">···</text>
				</view>
			</view>
		</view>

		<view class="app-chat__body">
			<!-- list-view 原生回收列表，结构对齐 uni-ai-x 的 uni-ai-chat.uvue -->
			<list-view v-if="messages.length > 0" id="app-chat-list" :key="activeId" direction="vertical" class="app-chat__scroll"
				:show-scrollbar="false" :initial-scroll-bottom="initialScrollBottom" :scroll-anchoring="true"
				:scroll-top="scrollTop" :scroll-into-view="scrollIntoViewId" :lower-threshold="48"
				@scroll="onListScroll" @scrolltolower="onListLower" @scrollend="onListScrollEnd"
				@touchstart="onListTouchStart" @touchend="onListTouchEnd" @touchcancel="onListTouchEnd">
				<list-item v-for="msg in messages" :key="msg.id" :type="msg.role === 'user' ? 1 : 2">
					<view class="app-chat__msg" :class="msg.role === 'user' ? 'app-chat__msg--user' : ''"
						:style="msgColStyle">
						<!-- 气泡宽度上限靠定宽 wrapper 实现：UCSS 的 max-width 不支持百分比；AI 消息占满整行，用户消息 82% 上限 -->
						<view class="app-chat__bubble-wrap"
							:class="msg.role === 'user' ? 'app-chat__bubble-wrap--user' : 'app-chat__bubble-wrap--ai'">
							<app-chat-bubble :message="msg" :show-head="headIds.indexOf(msg.id) >= 0"
								@approve="onInteractApprove" @answer="onInteractAnswer" @edit="onInteractEdit"
								@retry-history="onRetryHistory"></app-chat-bubble>
						</view>
					</view>
				</list-item>
				<!-- 底部留白：最后一条消息贴着输入区时会被裁掉半行，滚到底也读不全。
				     必须放在锚点之前：锚点要在最末尾，scroll-into-view 才是真正到底。 -->
				<list-item style="height:10px;"></list-item>
				<list-item style="height:1px;" id="msg-anchor-a" v-show="bottomAnchorId == 'msg-anchor-a'"></list-item>
				<list-item style="height:1px;" id="msg-anchor-b" v-show="bottomAnchorId == 'msg-anchor-b'"></list-item>
			</list-view>
			<text v-else class="app-chat__empty">{{ t('chat.empty') }}</text>
		</view>

		<!-- 展开态点空白处收起；放在输入区之前，输入区靠渲染顺序盖在它上面 -->
		<view v-if="expanded" class="app-chat__catcher" @click="expanded = false"></view>

		<app-composer v-model="draft" :expanded="expanded" :model="model" :tag="attachTag" :processing="processing"
			:column-style="colStyle" input-id="app-chat-composer-input" :attachments="pendingAttachments" @expand="expanded = true"
			@collapse="expanded = false" @send="onSend" @stop="onStop" @open-model="modelSheetVisible = true"
			@open-plus="plusSheetVisible = true" @remove-attach="onRemoveAttach"></app-composer>

		<app-run-sheet :visible="runSheetVisible" :device="device" :workspace="convWorkspace" :permission="permission"
			:lock-env="true" @close="runSheetVisible = false" @update-permission="onUpdatePermission"></app-run-sheet>

		<app-model-sheet :visible="modelSheetVisible" :model="model" :think="think" :context="context"
			@close="modelSheetVisible = false" @change="onChangeModel"></app-model-sheet>

		<app-plus-sheet :visible="plusSheetVisible" :selected-skill="selectedSkill"
			:connector-states="connectorStates" @close="plusSheetVisible = false"
			@select-skill="onSelectSkill" @toggle-connector="onToggleConnector" @attach="onAttach"></app-plus-sheet>

		<app-artifact-sheet :visible="artifactSheetVisible" :files="artifactFiles" :phase="artifactPhase"
			:error="artifactError" :additions="artifactAdditions" :deletions="artifactDeletions"
			:root="artifactRoot" @close="artifactSheetVisible = false"
			@retry="onReloadArtifacts"></app-artifact-sheet>

		<!-- APP 端禁用原生 dialogPage：其关闭动画期内重开会叠开原生页，滞留的透明页会吞掉全屏点击 -->
		<rice-action-sheet v-model:show="menuVisible" :actions="menuActions" :use-dialog-page="false"
			:custom-style="sheetStyle" :cancel-text="t('conv.cancel')" @select="onMenuSelect"></rice-action-sheet>

		<app-input-dialog :visible="renameVisible" :title="t('conv.renameTitle')" :value="title"
			@close="renameVisible = false" @confirm="onRenameConfirm"></app-input-dialog>
	</view>
</template>

<script setup lang="ts">
	import { computed, nextTick, onUnmounted, ref, watch } from 'vue'
	import type { ComputedRef, Ref } from 'vue'
	import { i18n } from '@/locale/i18n.ts'
	import { useViewport, CHAT_COLUMN_WIDTH } from '@/hooks/useViewport'
	import { useRunEnv, permissionLabel } from '@/hooks/useRunEnv'
	import { useConversations, inputWithinBudget } from '@/hooks/useConversations'
	import { workspaceLabel } from '@/hooks/useWorkspaces'
	import { gworkSignedIn } from '@/utils/gwork-auth.ts'
	import { refreshAssistantIdentity } from '@/hooks/useAssistantIdentity'
	import AppEnvBar from '@/components/app-env-bar/app-env-bar.uvue'
	import AppComposer from '@/components/app-composer/app-composer.uvue'
	import AppRunSheet from '@/components/app-run-sheet/app-run-sheet.uvue'
	import AppModelSheet from '@/components/app-model-sheet/app-model-sheet.uvue'
	import AppPlusSheet from '@/components/app-plus-sheet/app-plus-sheet.uvue'
	import AppArtifactSheet from '@/components/app-artifact-sheet/app-artifact-sheet.uvue'
	import AppInputDialog from '@/components/app-input-dialog/app-input-dialog.uvue'
	import AppChatBubble from '@/components/app-chat-bubble/app-chat-bubble.uvue'
	import type { ActionSheetAction } from '@/uni_modules/rice-ui/components/rice-action-sheet/type.uts'
	import { useArtifacts } from '@/hooks/useArtifacts'
	import { DEFAULT_WORKSPACE } from '@/data/app-data'
	import { pickCamera, pickAlbum, pickFile, mergeAttachments } from '@/utils/attach-picker'
	import type { AskAnswer, ChatBlock, ChatMessage, ConnectorOption, PendingAttachment, SkillOption } from '@/data/app-data'

	defineOptions({
		name: 'app-chat',
		styleIsolation: 'app-and-page'
	})

	const emit = defineEmits<{
		(e: 'back'): void
		(e: 'new-chat'): void
	}>()

	// 宽屏双栏下侧栏常驻，「转出会话抽屉」按钮无意义，由页面传 hide-menu 隐藏
	const props = withDefaults(defineProps<{
		hideMenu?: boolean
	}>(), {
		hideMenu: false
	})

	const { chatColumnStyle, paneWidth, sheetShellStyle } = useViewport()
	// 消息流/头部/输入列共用的限宽居中样式（窄屏为空串，保持原有撑满布局）
	const colStyle: ComputedRef<string> = chatColumnStyle
	// rice-action-sheet 外壳：宽屏限宽居中 + 矮视口限高
	const sheetStyle: ComputedRef<UTSJSONObject> = sheetShellStyle
	// 消息行自带 18px 横向内边距，列宽相应放宽，保证气泡可用宽度与头部/输入列一致
	const msgColStyle: ComputedRef<string> = computed<string>((): string => {
		if (colStyle.value.length === 0) return ''
		const pane: number = paneWidth.value
		const col: number = Math.min(CHAT_COLUMN_WIDTH + 36, pane)
		const margin: number = Math.round((pane - col) / 2)
		return 'width:' + col.toString() + 'px;margin-left:' + margin.toString() + 'px;'
	})

	const env = useRunEnv()
	const {
		activeConversation,
		renameConversation, togglePin, removeConversation, sendMessage, stopMessage,
		approveHitl, answerQuestion, setQuestionAnswer, retryHistory
	} = useConversations()

	const {
		device, deviceOnline, workspace, permission,
		model, think, context, selectedSkill, attachTag, connectorStates
	} = env

	const expanded: Ref<boolean> = ref<boolean>(false)
	const draft: Ref<string> = ref<string>('')
	/** 待发送附件（v1.1 内联 base64）：随下条消息发出后清空 */
	const pendingAttachments: Ref<PendingAttachment[]> = ref<PendingAttachment[]>([])
	// 产物弹层数据源：内核 /web/chat/changes/session（与桌面任务监控「产出」区同源）。
	// 绝不使用演示数据——拉取失败由弹层自身落 error 态并可重试。
	const {
		files: artifactFiles, phase: artifactPhase, error: artifactError,
		additions: artifactAdditions, deletions: artifactDeletions,
		load: loadArtifacts, reset: resetArtifacts, invalidate: invalidateArtifacts
	} = useArtifacts()
	/** 产物预览必须透传的会话工作区根（path 相对它；多工作区下不传会读错文件） */
	const artifactRoot: ComputedRef<string> = computed<string>((): string => {
		const conv = activeConversation.value
		if (conv == null) return ''
		return conv.workspace === DEFAULT_WORKSPACE ? '' : conv.workspace
	})
	const runSheetVisible: Ref<boolean> = ref<boolean>(false)
	const modelSheetVisible: Ref<boolean> = ref<boolean>(false)
	const plusSheetVisible: Ref<boolean> = ref<boolean>(false)
	const artifactSheetVisible: Ref<boolean> = ref<boolean>(false)
	const renameVisible: Ref<boolean> = ref<boolean>(false)
	const menuVisible: Ref<boolean> = ref<boolean>(false)
	const scrollTop: Ref<number> = ref<number>(0)
	const initialScrollBottom: Ref<boolean> = ref<boolean>(false)
	const bottomAnchorId: Ref<string> = ref<string>('msg-anchor-a')
	// list-view 的 scroll-into-view 仅鸿蒙端可靠；其余端靠 scrollTop 限幅震荡滚到底（对齐 uni-ai-x）
	const scrollIntoViewId: ComputedRef<string> = computed<string>((): string => {
		// #ifdef APP-HARMONY
		return bottomAnchorId.value
		// #endif
		// #ifndef APP-HARMONY
		return ''
		// #endif
	})

	const activeId: ComputedRef<string> = computed<string>((): string => {
		const conv = activeConversation.value
		return conv != null ? conv.id : ''
	})

	const title: ComputedRef<string> = computed<string>((): string => {
		const conv = activeConversation.value
		return conv != null ? conv.title : t('conv.newChat')
	})
	// 详情页环境行展示会话自身的工作区（而非全局当前选择）：会话归属不随切换漂移
	const convWorkspace: ComputedRef<string> = computed<string>((): string => {
		const conv = activeConversation.value
		return conv != null ? workspaceLabel(conv.workspace) : workspace.value
	})
	const messages: ComputedRef<ChatMessage[]> = computed<ChatMessage[]>((): ChatMessage[] => {
		const conv = activeConversation.value
		return conv != null ? conv.messages : []
	})
	// 回复中（含思考中）：驱动发送按钮 ⇄ 停止按钮切换，发送入口同步禁用（对齐 uni-ai-x state='processing'）
	const processing: ComputedRef<boolean> = computed<boolean>((): boolean => {
		return messages.value.some((msg: ChatMessage): boolean => msg.role === 'ai' && msg.status === 'processing')
	})
	// 消息数量 / 文本 / 过程块数量与内容变化后滚到底。
	// 【旧实现只跟 text.length】流式期间工具与子智能体帧只往 blocks 里写（正文没变），
	// scrollTick 不动 → 新行永远不触发滚动，用户停在半空看不到后续输出。
	// 这里把「块数量 + 块内文本长度」一起算进签名，任何可见高度变化都能触发。
	const scrollTick: ComputedRef<number> = computed<number>((): number => {
		const list: ChatMessage[] = messages.value
		const last: ChatMessage | undefined = list.length > 0 ? list[list.length - 1] : undefined
		if (last == null) return list.length
		let weight: number = last.text.length + last.summary.length
		last.blocks.forEach((item: ChatBlock): void => {
			// 卡体常驻展示（不再由 expanded 门控），故有界正文长度始终计入高度签名：
			// 长工具结果持续增长时 preview 有 120 字符上限，只盯 preview 会滚不到底。
			weight += 1 + item.preview.length + Math.min(item.body.length, 2400)
		})
		return list.length * 1000000 + last.blocks.length * 1000 + weight
	})

	/** 身份头分配：对齐桌面 assistantRowShouldShowHead（app-message.js:677-699）。
	 *  单位是「最近一条真实用户消息」——多轮对话每轮用户行后第一条 AI 行带头；
	 *  同轮内的续段（插话 / 问答记录 / HITL 恢复段）省头。
	 *  没有用户行（会话首条 / 异常 / 手工触发）时无条件带头：宁可多显示，不可丢头。 */
	const headIds: ComputedRef<string[]> = computed<string[]>((): string[] => {
		const list: ChatMessage[] = messages.value
		const ids: string[] = []
		let seenAiSinceUser: boolean = false
		for (let i = 0; i < list.length; i++) {
			const msg: ChatMessage = list[i]
			if (msg.role === 'user') {
				seenAiSinceUser = false
				continue
			}
			if (seenAiSinceUser) continue
			ids.push(msg.id)
			seenAiSinceUser = true
		}
		// 会话首条若是 AI 行（回放起点无用户行）也带头——上面循环已天然覆盖
		return ids
	})
	const pinned: ComputedRef<boolean> = computed<boolean>((): boolean => {
		const conv = activeConversation.value
		return conv != null && conv.pinned
	})
	const menuActions: ComputedRef<ActionSheetAction[]> = computed<ActionSheetAction[]>((): ActionSheetAction[] => {
		return [
			{ name: t('chat.menu.artifacts'), value: 'artifacts' },
			{ name: t('conv.menu.rename'), value: 'rename', icon: 'edit' },
			{ name: pinned.value ? t('conv.menu.unpin') : t('conv.menu.pin'), value: 'pin' },
			{ name: t('conv.menu.remove'), value: 'remove', icon: 'delete', color: 'var(--color-error)' }
		]
	})

	// 切换会话时让 list-view 整体重建并从底部开始（对齐 uni-ai-x：空列表不开 initial-scroll-bottom，
	// Android 蒸汽模式下会给空列表开底部锚定导致后续行不挂载）
	watch(activeId, (): void => {
		initialScrollBottom.value = messages.value.length > 0
		scrollTop.value = 0
		// 切会话重新贴底跟随：上一会话里用户上滑留下的暂停态不得跨会话残留
		listPinned.value = true
		listTouching.value = false
		listInertiaUntil = 0
		listViewport = 0
		// 产物清单按会话隔离：切走必须失效，否则上一条会话的产物会冒充当前会话
		resetArtifacts()
	})

	// 助手名称（桌面上可在「设置 → 通用」改名）：设备上线后再拉一次，
	// 启动期往往链路还没就绪，只靠 App.onLaunch 那一次会一直显示默认名
	watch(deviceOnline, (online: boolean): void => {
		if (online) refreshAssistantIdentity()
	}, { immediate: true })

	// 一轮任务跑完 → 产物账本已经变了。这里只「标脏」不清空：
	// 屏上清单先留着（避免闪 loading），但下次打开弹层必须重新拉，否则用户
	// 刚产出的文件在弹层里看不见（缓存冒充最新结果）。
	watch(processing, (now: boolean, before: boolean): void => {
		if (before && !now) invalidateArtifacts()
	})

	// 二次补滚 timer 持句柄：流式期间每帧都排一个 60ms 短 timer，
	// 新帧到来先清旧的（同一批高度变化只需补滚一次），卸载时一并清理（项目 timer 纪律）
	let scrollFixTimer: number = -1

	/* ---- 贴底跟随门禁（2026-11-27 用户报障「消息展示后上下滑动会卡住」）----
	   旧实现 scrollTick 每变一次就【无条件】把列表拽到底（每 token 一次 + 60ms 补滚），
	   用户上滑读历史时手指还在屏上就被拽回底部——「滑不动/卡住」的真因；
	   批次滚动窗早已有同款门禁（winPinned），消息列表此前漏配。
	   口径与批次窗一致：贴底自动跟随；用户手势期间离底即暂停；滑回底部恢复。
	   另：手势期间（含惯性余量）程序 scroll-top 一律不下发——
	   即便判定贴底，跟手期间强行设 scrollTop 也会打断原生滚动手势。 */
	const listPinned: Ref<boolean> = ref<boolean>(true)
	const listTouching: Ref<boolean> = ref<boolean>(false)
	/** touchend 后惯性保护窗：300ms 内的 scroll 事件仍按用户手势对待（批次窗同款） */
	let listInertiaUntil: number = 0
	/** 列表视口高（onListScroll 首帧实测）：gap 判定必须扣视口，否则永远误判离底 */
	let listViewport: number = 0

	function measureListViewport(): void {
		if (listViewport > 0) return
		const el = uni.getElementById('app-chat-list')
		if (el == null) return
		const rect = el.getBoundingClientRect()
		if (rect.height > 0) listViewport = rect.height
	}

	/** 距底距离：内容高 - 滚动位置 - 视口高。视口未实测时返回 -1（不可判，不动状态） */
	function listGapOf(e: UniScrollEvent): number {
		if (listViewport <= 0) return -1
		const d = e.detail
		return d.scrollHeight - d.scrollTop - listViewport
	}

	function onListScroll(e: UniScrollEvent): void {
		measureListViewport()
		const gap: number = listGapOf(e)
		// 贴底（≤48px，与 lower-threshold 同值）：恢复跟随（含程序滚底自身触发的事件）
		if (gap >= 0 && gap <= 48) {
			listPinned.value = true
			return
		}
		// 离底只在用户手势期间才暂停：scroll-anchoring 下内容长高也派发 scroll，
		// 此刻 scrollTop 未动而 scrollHeight 已增，非手势事件不算「上滑」（批次窗同款）
		const gesturing: boolean = listTouching.value || Date.now() < listInertiaUntil
		if (gesturing && gap > 48) listPinned.value = false
	}

	/** 触底事件必真（部分端 scrollHeight 不可靠，批次窗同款兜底）：恢复跟随 */
	function onListLower(): void {
		listPinned.value = true
	}

	/** 滚动结束（惯性停稳）：停在底部附近也恢复跟随，滑回底部后新帧继续跟 */
	function onListScrollEnd(e: UniScrollEvent): void {
		measureListViewport()
		const gap: number = listGapOf(e)
		if (gap >= 0 && gap <= 48) listPinned.value = true
	}

	function onListTouchStart(): void {
		listTouching.value = true
	}

	function onListTouchEnd(): void {
		listTouching.value = false
		listInertiaUntil = Date.now() + 300
	}

	/** 跟随判定：贴底 + 非手势期（含惯性保护窗）才允许程序滚底 */
	function listMayFollow(): boolean {
		return listPinned.value && !listTouching.value && Date.now() >= listInertiaUntil
	}

	// 消息数量或流式尾条内容变化后滚到底（仅贴底跟随时）
	watch(scrollTick, (): void => {
		nextTick((): void => {
			if (!listMayFollow()) return
			bottomAnchorId.value = bottomAnchorId.value === 'msg-anchor-a' ? 'msg-anchor-b' : 'msg-anchor-a'
			// 限幅在 10 万~20 万间震荡：持续递增会累计到数百万，导致 list-view 内部状态异常（uni-ai-x 经验）
			scrollTop.value = scrollTop.value > 100000 ? 100000 : scrollTop.value + 100000
		})
		if (scrollFixTimer !== -1) clearTimeout(scrollFixTimer)
		scrollFixTimer = setTimeout((): void => {
			scrollFixTimer = -1
			if (!listMayFollow()) return
			// 二次补滚：list-item 高度在首帧后还会变（流式 text 折行、图标字体异步就绪），
			// 只滚一次会停在「差一点点到底」的位置，表现为「到最底部展示有问题」
			scrollTop.value = scrollTop.value > 100000 ? 100000 : scrollTop.value + 100000
		}, 60)
	})

	onUnmounted((): void => {
		if (scrollFixTimer !== -1) clearTimeout(scrollFixTimer)
	})

	/** 返回键拦截：聊天态内嵌弹层（重命名 > 长按菜单 > 产物 > 加号 > 模型 > 运行环境）先消化，
	 *  宿主 onBackPress 经 ref 调用；返回 true 表示已消费。
	 *  不做这一环时返回键会直接把会话抽屉盖上来，z-index 更高的弹层成孤儿浮在抽屉上 */
	function handleBack(): boolean {
		if (renameVisible.value) {
			renameVisible.value = false
			return true
		}
		if (menuVisible.value) {
			menuVisible.value = false
			return true
		}
		if (artifactSheetVisible.value) {
			artifactSheetVisible.value = false
			return true
		}
		if (plusSheetVisible.value) {
			plusSheetVisible.value = false
			return true
		}
		if (modelSheetVisible.value) {
			modelSheetVisible.value = false
			return true
		}
		if (runSheetVisible.value) {
			runSheetVisible.value = false
			return true
		}
		return false
	}

	defineExpose({ handleBack })

	function t(key: string, values?: Record<string, string>): string {
		if (values == null) return i18n.global.t(key)
		return i18n.global.t(key, values)
	}

	/** 设计稿：点新建对话回到首页初始输入态，发送时才真正建会话 */
	function onNewChat(): void {
		expanded.value = false
		emit('new-chat')
	}

	function onRename(): void {
		renameVisible.value = true
	}

	function onRenameConfirm(value: string): void {
		renameVisible.value = false
		const conv = activeConversation.value
		if (conv == null) return
		renameConversation(conv.id, value)
		uni.showToast({ title: t('conv.renamed'), icon: 'none' })
	}

	/** 历史回放降级提示里的重试：清掉 loaded 标记后走同一套幂等历史加载，
	 *  目标是用 replay 帧重建过程与产物卡，而不是再展示一次 /messages 快照。 */
	function onRetryHistory(): void {
		if (activeId.value.length === 0) return
		retryHistory(activeId.value)
	}

	function onMenuSelect(action: ActionSheetAction): void {
		const key: string = action.value as string
		const conv = activeConversation.value
		if (conv == null) return
		if (key === 'artifacts') {
			artifactSheetVisible.value = true
			// 打开即拉：force=false 时同会话已有成功结果直接复用（反复打开零网络）
			loadArtifacts(conv)
			return
		}
		if (key === 'rename') {
			renameVisible.value = true
			return
		}
		if (key === 'pin') {
			const next: boolean = togglePin(conv.id)
			uni.showToast({ title: next ? t('conv.pinned') : t('conv.unpinned'), icon: 'none' })
			return
		}
		removeConversation(conv.id)
		uni.showToast({ title: t('conv.removed'), icon: 'none' })
		// 会话已删除，退回首页输入态
		emit('back')
	}

	function onSend(text: string): void {
		const content: string = text.trim()
		if (content.length === 0 && pendingAttachments.value.length === 0) {
			uni.showToast({ title: t('home.emptySend'), icon: 'none' })
			return
		}
		const conv = activeConversation.value
		if (conv == null) return
		// 回复中禁止再发：停止按钮已替换发送按钮，这里兜住键盘 confirm 等旁路入口
		if (processing.value) {
			uni.showToast({ title: t('chat.busySend'), icon: 'none' })
			return
		}
		// 前置校验放在清空草稿之前：拦截时用户输入必须保留
		if (!gworkSignedIn().value) {
			uni.showToast({ title: t('chat.loginRequired'), icon: 'none' })
			return
		}
		if (!deviceOnline.value || device.value.length === 0) {
			uni.showToast({ title: device.value.length === 0 ? t('chat.deviceRequired') : t('chat.deviceOffline'), icon: 'none' })
			return
		}
		const atts: PendingAttachment[] = pendingAttachments.value
		// 信封体积预检在清空草稿/附件之前：超限时用户输入必须原样保留
		if (!inputWithinBudget(content, atts)) return
		draft.value = ''
		expanded.value = false
		pendingAttachments.value = []
		const accepted: boolean = sendMessage(conv.id, content, undefined, atts,
			(failText: string, failAtts: PendingAttachment[]): void => {
				// 异步失败回填：正文回草稿、附件回待发送列（按当前值重校验合并）
				if (draft.value.length === 0) draft.value = failText
				if (failAtts.length > 0) pendingAttachments.value = mergeAttachments(pendingAttachments.value, failAtts)
			})
		if (!accepted) {
			draft.value = content
			pendingAttachments.value = mergeAttachments(pendingAttachments.value, atts)
		}
	}

	/** 停止当前回复：保留已吐出的内容并落「已停止」（对齐 uni-ai-x 的 state='stop'） */
	function onStop(): void {
		const conv = activeConversation.value
		if (conv == null) return
		stopMessage(conv.id)
	}

	/* ---- 交互卡（ask 问答 / HITL 审批）：气泡转发上来的三项操作，
	        统一落到 useConversations 的作答链路（提交即续轮，内置失败回退） ---- */

	function onInteractApprove(actionId: string, approved: boolean): void {
		const conv = activeConversation.value
		if (conv == null) return
		approveHitl(conv.id, actionId, approved)
	}

	function onInteractAnswer(actionId: string): void {
		const conv = activeConversation.value
		if (conv == null) return
		answerQuestion(conv.id, actionId)
	}

	function onInteractEdit(actionId: string, index: number, patch: AskAnswer): void {
		const conv = activeConversation.value
		if (conv == null) return
		setQuestionAnswer(conv.id, actionId, index, patch)
	}

	function onUpdatePermission(name: string): void {
		// 受理才提示；失败回滚与报错在 setPermission 内完成。展示名走 i18n（name 是协议码）
		if (!env.setPermission(name)) return
		uni.showToast({ title: t('home.permission.switched', { name: permissionLabel(name) }), icon: 'none' })
	}

	/** 选中即生效，不关闭弹层；与首页同口径 */
	function onChangeModel(nextModel: string, nextThink: string, nextContext: string): void {
		env.setModelConfig(nextModel, nextThink, nextContext)
	}

	/** 重试：失败态点「重试」强制重拉（force=true 绕过复用门禁） */
	function onReloadArtifacts(): void {
		loadArtifacts(activeConversation.value, true)
	}

	function onSelectSkill(id: string): void {
		// 再点同一技能=取消选择；id 是内核 slash 目录名，展示名走真实清单
		const next: string = selectedSkill.value === id ? '' : id
		selectedSkill.value = next
		const found = env.skills.value.find((s: SkillOption): boolean => s.id === next)
		attachTag.value = next.length > 0 ? t('home.skillTag', { name: found != null ? found.name : next }) : ''
		plusSheetVisible.value = false
		if (next.length > 0) {
			uni.showToast({ title: t('home.skills.selected', { name: found != null ? found.name : next }), icon: 'none' })
		}
	}

	function onToggleConnector(id: string): void {
		// 成功 toast 由提交结果驱动（onDone 仅在内核受理成功后回调），失败回滚在 hook 内
		env.toggleConnector(id, (on: boolean): void => {
			const found = env.connectors.value.find((c: ConnectorOption): boolean => c.id === id)
			const label: string = found != null ? found.name : id
			uni.showToast({
				title: on ? t('home.connectors.on', { name: label }) : t('home.connectors.off', { name: label }),
				icon: 'none'
			})
		})
	}

	/** 附件三入口（v1.1 内联 base64）：拍照/相册/文件 → 压缩 → 待发送列。
	 *  回填一律经 mergeAttachments 按当前值重校验（picker 互斥 + 限额兜底，防并发绕过） */
	function onAttach(kind: string): void {
		plusSheetVisible.value = false
		const existing: PendingAttachment[] = pendingAttachments.value
		if (kind === 'camera') {
			pickCamera(existing).then((item: PendingAttachment | null): void => {
				if (item != null) pendingAttachments.value = mergeAttachments(pendingAttachments.value, [item])
			})
			return
		}
		if (kind === 'album') {
			pickAlbum(existing).then((items: PendingAttachment[]): void => {
				if (items.length > 0) pendingAttachments.value = mergeAttachments(pendingAttachments.value, items)
			})
			return
		}
		pickFile(existing).then((items: PendingAttachment[]): void => {
			if (items.length > 0) pendingAttachments.value = mergeAttachments(pendingAttachments.value, items)
		})
	}

	function onRemoveAttach(index: number): void {
		const next: PendingAttachment[] = []
		for (let i = 0; i < pendingAttachments.value.length; i++) {
			if (i !== index) next.push(pendingAttachments.value[i])
		}
		pendingAttachments.value = next
	}
</script>

<style lang="scss">
	.app-chat {
		flex: 1;
		// 键盘压缩视口时必须允许收缩（flex 子项默认 min-height:auto 会拒绝收缩，
		// 底部输入盒被顶出可视范围——三轮报障「停止按钮被遮挡」的布局根因之一）
		min-height: 0;
		flex-direction: column;
		// 状态栏高度由页面根节点 .home 统一让出，组件内不再重复加
		padding-bottom: env(safe-area-inset-bottom);
		background-color: var(--color-bg);

		&__head {
			flex-direction: column;
			padding: 8px 14px;
			border-bottom-width: 1px;
			border-bottom-style: solid;
			border-bottom-color: var(--color-border-light);
		}

		&__row {
			flex-direction: row;
			align-items: center;
		}

		&__icon {
			width: 32px;
			height: 32px;
			align-items: center;
			justify-content: center;
			border-radius: 10px;
		}

		// 字体图标字号与颜色需在使用处显式声明（UCSS 不保证继承）
		&__back {
			font-size: 18px;
			color: var(--color-text-secondary);
		}

		// 标题与环境行同属一块，左边缘对齐，整体在返回按钮右侧垂直居中（设计稿 S3）
		&__hd {
			flex: 1;
			min-width: 0;
			flex-direction: column;
			align-items: flex-start;
			justify-content: center;
			padding: 2px 0;
		}

		&__title {
			// UCSS 的 max-width 不支持百分比；父级 __hd 为 min-width:0 的纵向 flex，文本默认拉伸占满宽度，配合 ellipsis 即可
			padding: 0 2px;
			font-size: 15px;
			font-weight: 720;
			line-height: 1.3;
			color: var(--color-text);
			overflow: hidden;
			text-overflow: ellipsis;
			white-space: nowrap;
		}

		&__env {
			margin-top: 2px;
			padding-left: 2px;
		}

		&__more {
			font-size: 16px;
			font-weight: 720;
			color: var(--color-text-secondary);
		}

		&__body {
			position: relative;
			flex: 1;
			min-height: 0;
		}

		&__scroll {
			flex: 1;
			min-height: 0;
			margin-top: 18px;
		}

		&__msg {
			padding: 0 18px;
			margin-bottom: 14px;
			flex-direction: row;

			// 定宽 wrap 是行内唯一子节点、默认靠左，仅 wrap 内部 flex-end 会让用户气泡停在 82% 分界处
			// 而非贴容器右缘；整行先右对齐把 wrap 推到右侧，气泡宽度上限不变
			&--user {
				justify-content: flex-end;
			}
		}

		// 气泡定宽容器：替代气泡上不被 UCSS 支持的 max-width: 82%；气泡在其中内容自适应、超宽换行
		&__bubble-wrap {
			flex-direction: row;

			// AI 消息占满整行：原生布局下长文本气泡会铺满容器宽，占满后右侧不留死区
			&--ai {
				flex: 1;
			}

			// 用户消息保持 82% 上限（width 只在基类未设 flex 时生效，故 flex: 1 仅放 AI 变体）
			&--user {
				width: 82%;
				justify-content: flex-end;
			}
		}

		&__empty {
			margin-top: 40px;
			padding: 0 18px;
			font-size: 12px;
			text-align: center;
			color: var(--color-text-tertiary);
		}

		&__catcher {
			position: absolute;
			left: 0;
			right: 0;
			top: 0;
			bottom: 0;
		}
	}
</style>
