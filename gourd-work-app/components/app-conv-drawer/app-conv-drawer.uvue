<template>
	<!-- 会话抽屉面板：浮层/常驻侧栏的尺寸由宿主提供，这里只负责会话列表与内嵌弹层。
		对齐 workbuddy：分组标题带箭头可折叠；工作区行点箭头展开会话子列表（带展开动画），
		整行不再是「选择工作空间」入口——工作空间在新对话输入区选择 -->
	<view class="app-conv-drawer">
		<view class="app-drawer">
			<view class="app-drawer__head">
				<view class="app-drawer__dev" @click="deviceSheetVisible = true">
					<view class="app-drawer__dev-dot"
						:class="deviceOnline ? 'app-drawer__dev-dot--on' : 'app-drawer__dev-dot--off'"></view>
					<text class="app-drawer__dev-name">{{ device }}</text>
					<rice-icon name="arrow-down" size="13px" color="var(--color-text-tertiary)"></rice-icon>
				</view>
				<view v-if="!props.hideClose" class="app-drawer__icon" @click="emit('close')">
					<rice-icon name="cross" size="18px" color="var(--color-text-secondary)"></rice-icon>
				</view>
			</view>

			<!-- rice-button 透明底，品牌色底由外层容器提供 -->
			<view class="app-drawer__new">
				<!-- 默认插槽覆盖了组件自带的 text，颜色/间距只能写在插槽内容上，text-color 等 props 不生效 -->
				<rice-button color="transparent" width="100%" height="52px" shape="square" @click="onNewChat">
					<text class="iconfont app-drawer__new-icon">&#xe6b6;</text>
					<text class="app-drawer__new-text">{{t('conv.newChat')}}</text>
                </rice-button>
			</view>

			<scroll-view class="app-drawer__scroll" direction="vertical" :show-scrollbar="false">
				<view class="app-drawer__content">
					<text v-if="remoteHint.length > 0" class="app-drawer__hint">{{ remoteHint }}</text>

					<!-- 任务组：标题带箭头可整组折叠（对齐 workbuddy「任务 ⌄」） -->
					<view class="app-drawer__group" @click="onTasksToggle">
						<text class="app-drawer__group-text">{{ t('conv.title') }}</text>
						<view class="app-drawer__group-arrow" :class="tasksCollapsed ? 'app-drawer__group-arrow--closed' : ''">
							<rice-icon name="arrow-down" size="12px" color="var(--color-text-tertiary)"></rice-icon>
						</view>
					</view>
					<view v-if="!tasksCollapsed" class="app-drawer__sect" :class="tasksReady ? 'app-drawer__sect--on' : ''">
						<app-conv-row v-for="(item, index) in visibleConversations" :key="item.id" :title="item.title"
							:time="formatRelativeTime(item.updatedAt)" :pinned="item.pinned"
							@open="onOpenConv(item.id)" @longpress="onConvLongpress(item.id, index)"></app-conv-row>
						<view v-if="defaultConversations.length > COLLAPSE_COUNT" class="app-drawer__more"
							@click="moreExpanded = !moreExpanded">
							<text class="app-drawer__more-text">{{ moreExpanded ? t('conv.collapse') : t('conv.expandMore') }}</text>
							<view class="app-drawer__more-icon" :class="moreExpanded ? 'app-drawer__more-icon--up' : ''">
								<rice-icon name="arrow-down" size="12px" color="var(--color-text-tertiary)"></rice-icon>
							</view>
						</view>
					</view>

					<!-- 空间组：列全部项目；行内箭头展开该空间的会话子列表，＋ 以该空间开新对话。
						不再有「选中工作区」的高亮/对勾——选择入口在新对话输入区 -->
					<view class="app-drawer__group" @click="onSpacesToggle">
						<text class="app-drawer__group-text">{{ t('conv.workspace') }} ({{ projectWorkspaces.length }})</text>
						<view class="app-drawer__group-arrow" :class="spacesCollapsed ? 'app-drawer__group-arrow--closed' : ''">
							<rice-icon name="arrow-down" size="12px" color="var(--color-text-tertiary)"></rice-icon>
						</view>
					</view>
					<view v-if="!spacesCollapsed" class="app-drawer__sect" :class="spacesReady ? 'app-drawer__sect--on' : ''">
						<view v-for="(ws, wsIndex) in projectWorkspaces" :key="ws.root" class="app-drawer__ws">
							<view class="app-drawer__ws-row" @click="toggleWs(ws.root)"
								@longpress="onWsLongpress(ws.name, wsIndex)">
								<text class="iconfont app-drawer__ws-glyph">&#xe67c;</text>
								<text class="app-drawer__ws-name">{{ ws.name }}</text>
								<view class="app-drawer__ws-icon"
									:class="openWs === ws.root ? 'app-drawer__ws-icon--open' : ''">
									<rice-icon name="arrow-down" size="13px" color="var(--color-text-tertiary)"></rice-icon>
								</view>
								<view class="app-drawer__ws-icon" @click.stop="onNewInWorkspace(ws.root)">
									<rice-icon name="plus" size="15px" color="var(--color-text-secondary)"></rice-icon>
								</view>
							</view>
							<view v-if="openWs === ws.root" class="app-drawer__ws-sub"
								:class="subReady ? 'app-drawer__ws-sub--on' : ''">
								<view v-for="(sub, subIndex) in conversationsOf(ws.root)" :key="sub.id"
									class="app-drawer__sub-row" @click="onOpenConv(sub.id)"
									@longpress="onSubLongpress(sub.id, wsIndex, subIndex)">
									<text class="app-drawer__sub-name">{{ sub.title }}</text>
									<text class="app-drawer__sub-time">{{ formatRelativeTime(sub.updatedAt) }}</text>
								</view>
								<text v-if="conversationsOf(ws.root).length === 0" class="app-drawer__sub-empty">{{ t('conv.empty') }}</text>
							</view>
						</view>
					</view>
				</view>
			</scroll-view>

			<view class="app-drawer__foot">
				<view class="app-drawer__mine" @click="onMine">
					<rice-avatar :src="avatar" size="32px" mode="aspectFill" radius="16px"></rice-avatar>
					<text class="app-drawer__username">{{ name }}</text>
					<text class="app-drawer__points-label">{{ t('conv.pointsLabel') }}</text>
					<text class="app-drawer__points-value">{{ points }}</text>
				</view>
				<view class="app-drawer__icon" @click="themeSheetVisible = true">
					<!-- 图标待字体图标补全 -->
				</view>
			</view>
		</view>

		<!-- APP 端禁用原生 dialogPage：其关闭动画期内重开会叠开原生页，滞留的透明页会吞掉全屏点击 -->
		<rice-action-sheet v-model:show="menuVisible" :actions="menuActions" :use-dialog-page="false"
			:custom-style="sheetStyle" :cancel-text="t('conv.cancel')" @select="onMenuSelect"></rice-action-sheet>

		<app-device-sheet :visible="deviceSheetVisible" :device="device" @close="deviceSheetVisible = false"
			@select="onSelectDevice"></app-device-sheet>

		<app-sheet :visible="themeSheetVisible" :title="t('theme.title')" @close="themeSheetVisible = false">
			<rice-cell v-for="item in THEME_OPTIONS" :key="item.value" :title="t(item.label)" :border="false"
				@click="onPickTheme(item.value)">
				<template #leftIcon>
					<rice-icon v-if="item.icon != null" :name="item.icon" size="16px" color="var(--color-primary)"
						:custom-style="optIconGap"></rice-icon>
					<text v-else-if="item.glyph != null" class="iconfont app-drawer__opt-glyph">{{ item.glyph }}</text>
				</template>
				<template #rightIcon>
					<rice-icon v-if="currentMode === item.value" name="checked" size="16px"
						color="var(--color-primary)"></rice-icon>
				</template>
			</rice-cell>
		</app-sheet>

		<app-input-dialog :visible="renameVisible" :title="renameTitle" :value="renameValue"
			@close="renameVisible = false" @confirm="onRenameConfirm"></app-input-dialog>
	</view>
</template>

<script setup lang="ts">
	import { computed, onUnmounted, ref } from 'vue'
	import type { ComputedRef, Ref } from 'vue'
	import { i18n } from '@/locale/i18n.ts'
	import { useTheme } from '@/hooks/useTheme'
	import type { ThemeMode } from '@/hooks/useTheme'
	import { useViewport } from '@/hooks/useViewport'
	import { useRunEnv } from '@/hooks/useRunEnv'
	import { useUser } from '@/hooks/useUser'
	import { useConversations } from '@/hooks/useConversations'
	import { formatRelativeTime } from '@/utils/tools.ts'
	import { useWorkspaces } from '@/hooks/useWorkspaces'
	import { useDevices } from '@/hooks/useDevices'
	import { gworkSignedIn } from '@/utils/gwork-auth.ts'
	import type { Conversation, WorkspaceOption } from '@/data/app-data'
	import AppSheet from '@/components/app-sheet/app-sheet.uvue'
	import AppDeviceSheet from '@/components/app-device-sheet/app-device-sheet.uvue'
	import AppInputDialog from '@/components/app-input-dialog/app-input-dialog.uvue'
	import AppConvRow from '@/components/app-conv-row/app-conv-row.uvue'
	import type { ActionSheetAction } from '@/uni_modules/rice-ui/components/rice-action-sheet/type.uts'

	defineOptions({
		name: 'app-conv-drawer',
		styleIsolation: 'app-and-page'
	})

	type MenuKind = 'conv' | 'ws'
	type MenuState = { kind: MenuKind; id: string; name: string }

	type ThemeOption = { value: ThemeMode; label: string; icon: string | null; glyph: string | null }

	// sun 走 rice-icon；暗黑 / 跟随系统在其内置字体里缺字，走全局 iconfont 码点
	const THEME_OPTIONS: ThemeOption[] = [
		{ value: 'light', label: 'theme.light', icon: 'sun', glyph: null },
		{ value: 'dark', label: 'theme.dark', icon: null, glyph: '' },
		{ value: 'auto', label: 'theme.auto', icon: null, glyph: '' }
	]

	const emit = defineEmits<{
		(e: 'close'): void
		(e: 'open-conv', id: string): void
		(e: 'new-chat'): void
		(e: 'new-in-ws', root: string): void
	}>()

	// 宽屏双栏下侧栏常驻，关闭按钮无意义，由页面传 hide-close 隐藏
	const props = withDefaults(defineProps<{
		hideClose?: boolean
	}>(), {
		hideClose: false
	})

	const { currentMode, setThemeMode } = useTheme()
	const { sheetShellStyle } = useViewport()
	// rice-action-sheet 外壳：宽屏限宽居中 + 矮视口限高
	const sheetStyle: ComputedRef<UTSJSONObject> = sheetShellStyle
	const env = useRunEnv()
	const { device, deviceOnline } = env
	const { name, points, avatar } = useUser()
	const {
		conversations, defaultConversations, conversationsOf,
		setActive, renameConversation, togglePin, removeConversation, listError
	} = useConversations()
	const spaces = useWorkspaces()
	const { activeDeviceId } = useDevices()

	/** 折叠阈值：默认只展示前 N 条会话 */
	const COLLAPSE_COUNT: number = 4

	const MINE_PAGE: string = '/pages/mine/index'

	const moreExpanded: Ref<boolean> = ref<boolean>(false)
	const openWs: Ref<string> = ref<string>('')
	const deviceSheetVisible: Ref<boolean> = ref<boolean>(false)
	const themeSheetVisible: Ref<boolean> = ref<boolean>(false)
	const menuVisible: Ref<boolean> = ref<boolean>(false)
	const menu: Ref<MenuState | null> = ref<MenuState | null>(null)
	const renameVisible: Ref<boolean> = ref<boolean>(false)
	const renameTitle: Ref<string> = ref<string>('')
	const renameValue: Ref<string> = ref<string>('')
	/** 待重命名的目标；ws 时 id 存工作区名 */
	const renameTarget: Ref<{ kind: MenuKind; id: string } | null> = ref<{ kind: MenuKind; id: string } | null>(null)

	/* ---- 展开动画：v-if 挂载后下一拍翻 ready 类，opacity+translateY 过渡；
	        收起直接卸载（抽屉场景收起动画可省，避免高度动画在 UCSS 的兼容坑） ---- */
	const tasksCollapsed: Ref<boolean> = ref<boolean>(false)
	const spacesCollapsed: Ref<boolean> = ref<boolean>(false)
	const tasksReady: Ref<boolean> = ref<boolean>(true)
	const spacesReady: Ref<boolean> = ref<boolean>(true)
	// 初始 true：不变式「无挂载子列表时恒 true」，首次展开由 armSub 翻 false 播入场动画
	const subReady: Ref<boolean> = ref<boolean>(true)
	// 三个入场动画各配独立 timer：共享单 timer 时快速交叉展开会清掉前一个回调，
	// 被清的 flag 永停 false → 整段 opacity:0 隐身（不只是没动画）
	let tasksTimer: number = -1
	let spacesTimer: number = -1
	let subTimer: number = -1

	function armTasks(): void {
		tasksReady.value = false
		if (tasksTimer !== -1) clearTimeout(tasksTimer)
		tasksTimer = setTimeout((): void => {
			tasksTimer = -1
			tasksReady.value = true
		}, 30)
	}

	function armSpaces(): void {
		spacesReady.value = false
		if (spacesTimer !== -1) clearTimeout(spacesTimer)
		spacesTimer = setTimeout((): void => {
			spacesTimer = -1
			spacesReady.value = true
		}, 30)
	}

	function armSub(): void {
		subReady.value = false
		if (subTimer !== -1) clearTimeout(subTimer)
		subTimer = setTimeout((): void => {
			subTimer = -1
			subReady.value = true
		}, 30)
	}

	// 分组重新展开时播一次入场动画
	function onTasksToggle(): void {
		tasksCollapsed.value = !tasksCollapsed.value
		if (!tasksCollapsed.value) armTasks()
	}

	function onSpacesToggle(): void {
		spacesCollapsed.value = !spacesCollapsed.value
		if (!spacesCollapsed.value) armSpaces()
	}

	function toggleWs(root: string): void {
		if (openWs.value === root) {
			openWs.value = ''
			// 收起即撤销在途入场 timer 并复位标志：不变式「无挂载子列表时 subReady 恒 true」。
			// 否则极快点按（展开→收起→再展开）时旧 timer 与新 armSub 的 false 交错，
			// 新挂载的子列表可能停在 opacity:0 永久隐身
			if (subTimer !== -1) {
				clearTimeout(subTimer)
				subTimer = -1
			}
			subReady.value = true
			return
		}
		openWs.value = root
		armSub()
	}

	/** 返回键拦截：抽屉内嵌弹层（重命名 > 长按菜单 > 设备 > 外观）先消化，
		宿主 onBackPress 经 ref 调用；返回 true 表示已消费，抽屉不收起 */
	function handleBack(): boolean {
		if (renameVisible.value) {
			renameVisible.value = false
			return true
		}
		if (menuVisible.value) {
			menuVisible.value = false
			return true
		}
		if (deviceSheetVisible.value) {
			deviceSheetVisible.value = false
			return true
		}
		if (themeSheetVisible.value) {
			themeSheetVisible.value = false
			return true
		}
		return false
	}

	defineExpose({ handleBack })

	onUnmounted((): void => {
		if (tasksTimer !== -1) clearTimeout(tasksTimer)
		if (spacesTimer !== -1) clearTimeout(spacesTimer)
		if (subTimer !== -1) clearTimeout(subTimer)
	})

	// 项目工作区清单（/web/chat/projects 权威 + sessions projectRoot 兜底）：
	// 必须包含全部项目——抽屉只浏览不选择，过滤任何一行都会把任务藏了
	const projectWorkspaces: ComputedRef<WorkspaceOption[]> = computed<WorkspaceOption[]>((): WorkspaceOption[] => {
		return spaces.projects.value
	})
	/** 未登录/无设备/加载失败的引导文案；正常时为空串 */
	const remoteHint: ComputedRef<string> = computed<string>((): string => {
		if (!gworkSignedIn().value) return t('chat.loginRequired')
		if (activeDeviceId.value.length === 0) return t('chat.deviceRequired')
		if (listError.value.length > 0) return listError.value
		if (conversations.value.length === 0) return t('conv.emptyRemote')
		return ''
	})
	const visibleConversations: ComputedRef<Conversation[]> = computed<Conversation[]>((): Conversation[] => {
		const list: Conversation[] = defaultConversations.value
		if (moreExpanded.value) return list
		return list.slice(0, COLLAPSE_COUNT)
	})
	/** 长按菜单用 rice-action-sheet；pin 无对应字体图标，省略 icon */
	const menuActions: ComputedRef<ActionSheetAction[]> = computed<ActionSheetAction[]>((): ActionSheetAction[] => {
		const state: MenuState | null = menu.value
		if (state == null) return []
		if (state.kind === 'conv') {
			const conv: Conversation | null = findConv(state.id)
			const pinned: boolean = conv != null && conv.pinned
			// 子列表里的会话同样走 conv 菜单，置顶/删除对任意工作区的会话生效
			return [
				{ name: t('conv.menu.rename'), value: 'rename', icon: 'edit' },
				{ name: pinned ? t('conv.menu.unpin') : t('conv.menu.pin'), value: 'pin' },
				{ name: t('conv.menu.remove'), value: 'remove', color: 'var(--color-error)' }
			]
		}
		return [
			{ name: t('conv.menu.renameWs'), value: 'rename', icon: 'edit' },
			{ name: t('conv.menu.pinWs'), value: 'pin' },
			{ name: t('conv.menu.removeWs'), value: 'remove', color: 'var(--color-error)' }
		]
	})

	function t(key: string, values?: Record<string, string>): string {
		if (values == null) return i18n.global.t(key)
		return i18n.global.t(key, values)
	}

	const optIconGap: UTSJSONObject = { marginRight: '10px' }

	function findConv(id: string): Conversation | null {
		const found: Conversation | undefined = conversations.value.find((item: Conversation): boolean => item.id === id)
		return found ?? null
	}

	/** 不预建会话：空会话会一直留在列表里，且发送时首页还会再建一条；
		统一由首页复位到初始输入态，发送时才真正建会话 */
	function onNewChat(): void {
		emit('new-chat')
	}

	function onOpenConv(id: string): void {
		setActive(id)
		emit('open-conv', id)
	}

	/** 工作区＋：新对话默认挂到该空间，由首页复位输入态并设置工作空间，
		发送时才在该工作区建会话（不预建，避免留下空会话） */
	function onNewInWorkspace(root: string): void {
		emit('new-in-ws', root)
	}

	function onSelectDevice(name: string, online: boolean): void {
		env.setDevice(name, online)
		uni.showToast({ title: t('home.device.switched', { name: name }), icon: 'none' })
	}

	function onPickTheme(mode: ThemeMode): void {
		setThemeMode(mode)
		themeSheetVisible.value = false
		uni.showToast({ title: t('conv.themeSwitched'), icon: 'none' })
	}

	function onMine(): void {
		uni.navigateTo({ url: MINE_PAGE })
	}

	/** 菜单为全局 action-sheet，不再按被按行定位；index 参数保留以匹配模板调用 */
	function onConvLongpress(id: string, index: number): void {
		const conv: Conversation | null = findConv(id)
		if (conv == null) return
		menu.value = { kind: 'conv', id: id, name: conv.title }
		menuVisible.value = true
	}

	function onWsLongpress(name: string, wsIndex: number): void {
		menu.value = { kind: 'ws', id: name, name: name }
		menuVisible.value = true
	}

	function onSubLongpress(id: string, wsIndex: number, subIndex: number): void {
		const conv: Conversation | null = findConv(id)
		if (conv == null) return
		menu.value = { kind: 'conv', id: id, name: conv.title }
		menuVisible.value = true
	}

	function onMenuSelect(action: ActionSheetAction, index: number): void {
		onMenuAction(String(action.value ?? ''))
	}

	function onMenuAction(key: string): void {
		const state: MenuState | null = menu.value
		if (state == null) return
		menu.value = null
		if (key === 'pin') {
			if (state.kind === 'conv') {
				const pinned: boolean = togglePin(state.id)
				uni.showToast({ title: pinned ? t('conv.pinned') : t('conv.unpinned'), icon: 'none' })
				return
			}
			uni.showToast({ title: t('conv.wsPinned', { name: state.name }), icon: 'none' })
			return
		}
		if (key === 'remove') {
			if (state.kind === 'conv') {
				removeConversation(state.id)
				uni.showToast({ title: t('conv.removed'), icon: 'none' })
				return
			}
			uni.showToast({ title: t('conv.wsRemoved', { name: state.name }), icon: 'none' })
			return
		}
		renameTarget.value = { kind: state.kind, id: state.id }
		renameTitle.value = state.kind === 'conv' ? t('conv.renameTitle') : t('conv.renameWsTitle')
		renameValue.value = state.name
		renameVisible.value = true
	}

	function onRenameConfirm(value: string): void {
		const target = renameTarget.value
		renameVisible.value = false
		if (target == null) return
		if (value.trim().length === 0) return
		if (target.kind === 'conv') {
			renameConversation(target.id, value)
			uni.showToast({ title: t('conv.renamed'), icon: 'none' })
			return
		}
		uni.showToast({ title: t('conv.wsRenamePending'), icon: 'none' })
	}
</script>

<style lang="scss">
	// 面板宿主：浮层抽屉/常驻侧栏由宿主提供尺寸，顶部状态栏留白由宿主统一处理
	.app-conv-drawer {
		flex: 1;
		flex-direction: column;
	}

	.app-drawer {
		flex: 1;
		flex-direction: column;
		background-color: var(--color-bg);

		&__head {
			flex-direction: row;
			align-items: center;
			justify-content: space-between;
			padding: 8px 14px;
		}

		&__dev {
			flex-direction: row;
			align-items: center;
		}

		&__dev-dot {
			width: 7px;
			height: 7px;
			margin-right: 7px;
			border-radius: 4px;

			&--on {
				background-color: var(--color-success);
			}

			&--off {
				background-color: var(--color-text-tertiary);
			}
		}

		&__dev-name {
			margin-right: 5px;
			font-size: 15px;
			font-weight: 650;
			color: var(--color-text);
		}

		&__icon {
			width: 32px;
			height: 32px;
			align-items: center;
			justify-content: center;
			border-radius: 10px;
		}

		&__new {
