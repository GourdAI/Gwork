		&__row-args,
		&__row-preview {
			/* 单行摘要：吃掉剩余宽度，超长用省略号收口，右侧留给行尾状态槽。
			   两者模板上互斥（args 优先），CSS 不再各给 flex:1 造成互相挤压重叠。 */
			flex: 1;
			min-width: 0;
			margin-left: 8px;
			font-size: 13px;
			line-height: 20px;
			color: var(--color-text-tertiary);
