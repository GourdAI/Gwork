			line-height: 20px;
			color: var(--color-text-secondary);
			background-color: transparent;
		}

		/* 过程正文段容器：markdown 渲染态（app-md-text 自带字号/行距/主题变量），
		   与行头保持缩进层次；替代旧纯文本 row-body--process-text（原文 dump 已废） */
		&__process-md {
