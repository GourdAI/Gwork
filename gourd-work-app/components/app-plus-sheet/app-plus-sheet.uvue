<template>
	<app-sheet :visible="visible" :title="title" :show-back="view !== 'main'" :show-search="view !== 'main'"
		:compact="view !== 'main'" :tall="view !== 'main'" @close="emit('close')" @back="onBack" @search="onSearch">
		<view v-if="view === 'main'">
			<!-- 附件三入口（v1.1 真实链路）：拍照/相册/文件 → 压缩 → base64 内联进 input，
				 由内核走与桌面 multipart 相同的落盘+注入；不再写假 tag -->
			<view class="app-plus__tiles">
				<!-- 图标/文字色必须用 theme.scss 里真实存在的 token（--color-text 系）：
					 曾写 --color-text-primary（未定义）→ 原生 var() 解析失败落默认黑，
					 暗色深底上隐形（用户报障真因）。图标随 PC .plus-menu-item svg 用二级灰。 -->
				<view class="app-plus__tile" @click="emit('attach', 'camera')">
					<rice-icon name="camera" size="24px" color="var(--color-text-secondary)"></rice-icon>
					<text class="app-plus__tile-text">{{ t('home.plus.camera') }}</text>
				</view>
				<view class="app-plus__tile" @click="emit('attach', 'album')">
					<rice-icon name="photo" size="24px" color="var(--color-text-secondary)"></rice-icon>
					<text class="app-plus__tile-text">{{ t('home.plus.album') }}</text>
				</view>
				<!-- UCSS 不支持 :last-child，末位块用修饰类去右边距 -->
			<view class="app-plus__tile app-plus__tile--last" @click="emit('attach', 'file')">
					<rice-icon name="upload" size="24px" color="var(--color-text-secondary)"></rice-icon>
					<text class="app-plus__tile-text">{{ t('home.plus.file') }}</text>
				</view>
			</view>
			<view class="app-plus__opt">
				<!-- spark 图标待字体图标补全 -->
				<rice-cell :border="false" center :custom-style="cellStyle" @click="openView('skills')">
					<template #title>
						<view class="app-plus__ot-wrap">
							<view class="app-plus__ot-icon">
								<text class="iconfont app-plus__ot-icon-font">&#xe7ab;</text>
							</view>
							<view class="app-plus__ot">
								<text class="app-plus__ot-title">{{ t('home.plus.skills') }}</text>
								<text class="app-plus__ot-desc">{{ t('home.plus.skillsHint') }}</text>
							</view>
						</view>
					</template>
					<template #rightIcon>
						<view class="app-plus__ov">
							<text class="app-plus__ov-text">{{ selectedSkillLabel }}</text>
							<rice-icon name="arrow-right" size="14px" color="var(--color-text-tertiary)"></rice-icon>
						</view>
					</template>
				</rice-cell>
			</view>

			<view class="app-plus__opt">
				<!-- link 图标待字体图标补全 -->
				<rice-cell :border="false" center :custom-style="cellStyle" @click="openView('connectors')">
					<template #title>
						<view class="app-plus__ot-wrap">
							<view class="app-plus__ot-icon">
								<text class="iconfont app-plus__ot-icon-font">&#xe62b;</text>
							</view>
							<view class="app-plus__ot">
								<text class="app-plus__ot-title">{{ t('home.plus.connectors') }}</text>
								<text class="app-plus__ot-desc">{{ t('home.plus.connectorsHint') }}</text>
							</view>
						</view>
					</template>
					<template #rightIcon>
						<view class="app-plus__ov">
							<text class="app-plus__ov-text">{{ connectorSummary }}</text>
							<rice-icon name="arrow-right" size="14px" color="var(--color-text-tertiary)"></rice-icon>
						</view>
					</template>
				</rice-cell>
			</view>
		</view>

		<view v-else-if="view === 'skills'">
			<rice-search v-if="skillsSearchActive" v-model="skillQuery" class="app-plus__search" shape="round"
				:placeholder="t('home.skills.search')" :placeholder-style="placeholderStyle" :clearable="true"
				:focus="searchFocused" @focus="searchFocused = true" @blur="searchFocused = false"></rice-search>
			<view v-for="item in filteredSkills" :key="item.id" class="app-plus__skill"
				:class="item.id === selectedSkill ? 'app-plus__skill--on' : ''">
				<rice-cell :border="false" center :custom-style="cellStyle" @click="emit('select-skill', item.id)">
					<template #leftIcon>
						<rice-tag :text="item.badge" :color="item.color" text-size="16px" :custom-style="badgeStyle"></rice-tag>
					</template>
					<template #title>
						<view class="app-plus__skill-tx">
							<text class="app-plus__skill-name">{{ item.name }}</text>
							<text class="app-plus__skill-desc">{{ item.desc }}</text>
						</view>
					</template>
					<template #rightIcon>
						<view v-if="item.id === selectedSkill" class="app-plus__skill-check">
							<rice-icon name="checked" size="16px" color="var(--color-primary)"></rice-icon>
						</view>
					</template>
				</rice-cell>
			</view>
			<text v-if="filteredSkills.length === 0" class="app-plus__empty">{{ t('home.skills.empty') }}</text>
		</view>

		<view v-else>
			<rice-search v-if="connectorsSearchActive" v-model="connectorQuery" class="app-plus__search" shape="round"
				:placeholder="t('home.connectors.search')" :placeholder-style="placeholderStyle" :clearable="true"
				:focus="searchFocused" @focus="searchFocused = true" @blur="searchFocused = false"></rice-search>
			<text v-if="!connectorSelectable" class="app-plus__readonly">{{ t('home.connectors.readonly') }}</text>
			<view v-for="item in filteredConnectors" :key="item.id" class="app-plus__conn">
				<rice-cell :border="false" center :custom-style="cellStyle" @click="onToggleRow(item.id)">
					<template #leftIcon>
						<view class="app-plus__conn-icon" :style="'background-color:' + item.color">
							<!-- file/mountain 无对应图标，待字体图标补全 -->
							<rice-icon v-if="riceIconName(item.icon) !== ''" :name="riceIconName(item.icon)" size="22px"
								color="var(--color-on-solid)"></rice-icon>
						</view>
					</template>
					<template #title>
						<view class="app-plus__conn-tx">
							<text class="app-plus__conn-name">{{ item.name }}</text>
							<text class="app-plus__conn-desc">{{ item.desc }}</text>
						</view>
					</template>
					<template #rightIcon>
						<!-- switch 自身 change 已触发一次 toggle，阻断冒泡避免再吃到 cell 的 click -->
						<view class="app-plus__conn-sw" @click.stop>
							<rice-switch :model-value="connectorOn(item.id)" width="44px" active-color="var(--color-primary)"
								inactive-color="var(--color-border)" :disabled="!connectorSelectable || !deviceOnline"
								@change="onToggleRow(item.id)"></rice-switch>
						</view>
					</template>
				</rice-cell>
			</view>
			<text v-if="filteredConnectors.length === 0" class="app-plus__empty">{{ t('home.connectors.empty') }}</text>
			<text class="app-plus__conn-tip">{{ t('home.connectors.tip') }}</text>
		</view>
	</app-sheet>
</template>

<script setup lang="ts">
	import { computed, ref, watch } from 'vue'
	import type { ComputedRef, Ref } from 'vue'
	import { i18n } from '@/locale/i18n.ts'
	import AppSheet from '@/components/app-sheet/app-sheet.uvue'
	import { useRunEnv } from '@/hooks/useRunEnv'
	import type { ConnectorOption, SkillOption } from '@/data/app-data'

	defineOptions({
		name: 'app-plus-sheet',
		styleIsolation: 'app-and-page'
	})

	// 设计稿图标名到 rice-icon 字体名的映射，无对应图标留空，待字体图标补全后再填
	const RICE_ICON_MAP: Record<string, string> = {
		file: '',
		mountain: ''
	}

	const props = defineProps<{
		visible: boolean
		selectedSkill: string
		connectorStates: Record<string, boolean>
	}>()

	const emit = defineEmits<{
		(e: 'close'): void
		(e: 'select-skill', id: string): void
		(e: 'toggle-connector', id: string): void
		(e: 'attach', kind: string): void
	}>()

	// 真实清单来自设备内核（skills/installed、mcp/servers）；组件自取共享态，
	// 宿主只负责选择事件与附件选择器
	const env = useRunEnv()
	const connectorSelectable: ComputedRef<boolean> = computed<boolean>((): boolean => env.connectorSelectable.value)
	// 离线时开关禁用置灰：提交必失败，不给「点了又弹回」的假交互
	const deviceOnline: ComputedRef<boolean> = computed<boolean>((): boolean => env.deviceOnline.value)

	function onToggleRow(id: string): void {
		if (!connectorSelectable.value || !deviceOnline.value) return
		emit('toggle-connector', id)
	}
	const selectedSkillLabel: ComputedRef<string> = computed<string>((): string => {
		if (props.selectedSkill.length === 0) return t('home.plus.select')
		const found: SkillOption | undefined = env.skills.value.find((s: SkillOption): boolean => s.id === props.selectedSkill)
		return found != null ? found.name : props.selectedSkill
	})
	const connectorSummary: ComputedRef<string> = computed<string>((): string => {
		let n = 0
		env.connectors.value.forEach((c: ConnectorOption): void => {
			if (props.connectorStates[c.id] === true) n += 1
		})
		return n > 0 ? t('home.plus.picked', { n: n.toString() }) : t('home.plus.select')
	})

	type SheetView = 'main' | 'skills' | 'connectors'

	const TITLE_KEYS: Record<string, string> = {
		main: 'home.plus.title',
		skills: 'home.skills.title',
		connectors: 'home.connectors.title'
	}

	const view: Ref<SheetView> = ref<SheetView>('main')
	const skillsSearchActive: Ref<boolean> = ref<boolean>(false)
	const connectorsSearchActive: Ref<boolean> = ref<boolean>(false)
	const skillQuery: Ref<string> = ref<string>('')
	const connectorQuery: Ref<string> = ref<string>('')
	const searchFocused: Ref<boolean> = ref<boolean>(false)

	const title: ComputedRef<string> = computed<string>((): string => t(TITLE_KEYS[view.value]))
	const placeholderStyle: ComputedRef<string> = computed<string>((): string => {
		return 'color:var(--color-text-tertiary);'
	})
	// 卡片底色与边框在外层卡片上，cell 本身透明，只承担布局与点击
	const cellStyle = { backgroundColor: 'transparent', padding: '0' }
	const badgeStyle: UTSJSONObject = {
		width: '40px',
		height: '40px',
		'border-radius': '12px',
		'margin-right': '12px'
	}
	const filteredSkills: ComputedRef<SkillOption[]> = computed<SkillOption[]>((): SkillOption[] => {
		const keyword: string = skillQuery.value.trim().toLowerCase()
		if (keyword.length === 0) return env.skills.value
		return env.skills.value.filter((item: SkillOption): boolean => {
			return (item.name + item.desc).toLowerCase().indexOf(keyword) >= 0
		})
	})
	const filteredConnectors: ComputedRef<ConnectorOption[]> = computed<ConnectorOption[]>((): ConnectorOption[] => {
		const keyword: string = connectorQuery.value.trim().toLowerCase()
		if (keyword.length === 0) return env.connectors.value
		return env.connectors.value.filter((item: ConnectorOption): boolean => {
			return (item.name + item.desc).toLowerCase().indexOf(keyword) >= 0
		})
	})

	watch((): boolean => props.visible, (visible: boolean): void => {
		if (!visible) return
		view.value = 'main'
		resetSearch()
		// 打开即拉真实清单（设备离线/未登录时内部直接返回，列表空态兜底）
		env.refreshSkills()
		env.refreshConnectors()
	})

	function t(key: string): string {
		return i18n.global.t(key)
	}

	function riceIconName(name: string): string {
		return RICE_ICON_MAP[name] ?? ''
	}

	function resetSearch(): void {
		skillsSearchActive.value = false
		connectorsSearchActive.value = false
		skillQuery.value = ''
		connectorQuery.value = ''
		searchFocused.value = false
	}

	function connectorOn(name: string): boolean {
		return props.connectorStates[name] ?? false
	}

	function openView(next: SheetView): void {
		view.value = next
		resetSearch()
	}

	function onBack(): void {
		view.value = 'main'
		resetSearch()
	}

	function onSearch(): void {
		if (view.value === 'skills') {
			skillsSearchActive.value = !skillsSearchActive.value
			searchFocused.value = skillsSearchActive.value
			if (!skillsSearchActive.value) {
				skillQuery.value = ''
			}
			return
		}
		connectorsSearchActive.value = !connectorsSearchActive.value
		searchFocused.value = connectorsSearchActive.value
		if (!connectorsSearchActive.value) {
			connectorQuery.value = ''
		}
	}
</script>

<style lang="scss">
	.app-plus {
		&__opt {
			margin-bottom: 10px;
			padding: 14px;
			border-radius: 16px;
			background-color: var(--color-bg-card);
		}

		&__tiles {
			flex-direction: row;
			margin-bottom: 10px;
		}

		&__tile {
			flex: 1;
			flex-direction: column;
			align-items: center;
			justify-content: center;
			padding: 20px 0;
			border-radius: 16px;
			background-color: var(--color-bg-card);
			// 描边对齐 PC .attachment-item-file 的 1px --border-color：暗色下卡片底
			// (#1c1c20) 与弹层底 (#17171a) 仅差 5 个灰阶，无描边时磁贴近乎隐形
			border-width: 1px;
			border-style: solid;
			border-color: var(--color-border);
			margin-right: 10px;
		}

		&__tile--last {
			margin-right: 0;
		}

		&__tile-text {
			font-size: 13px;
			// --color-text-primary 不存在（theme.scss 一级文本叫 --color-text），
			// 未定义 token 在原生端解析失败落默认黑 → 暗色隐形
			color: var(--color-text);
			margin-top: 10px;
		}

		&__readonly {
			font-size: 12px;
			color: var(--color-text-tertiary);
			margin: 0 4px 10px;
		}

		&__ot-wrap {
			flex: 1;
			min-width: 0;
			flex-direction: row;
			align-items: center;
		}

		&__ot-icon {
			width: 40px;
			height: 40px;
			margin-right: 12px;
			border-radius: 12px;
			background-color: var(--color-brand-soft);
			align-items: center;
			justify-content: center;
		}

		// 色块内的字体图标，颜色需在使用处显式声明（UCSS 不保证继承）
		&__ot-icon-font {
			font-size: 22px;
			color: var(--color-primary);
		}

		&__ot {
			flex: 1;
			min-width: 0;
			flex-direction: column;
		}

		&__ot-title {
			font-size: 15px;
			font-weight: 700;
			color: var(--color-text);
		}

		&__ot-desc {
			margin-top: 3px;
			font-size: 12px;
			line-height: 16px;
			color: var(--color-text-tertiary);
		}

		&__ov {
			flex-direction: row;
			align-items: center;
		}

		&__ov-text {
			max-width: 96px;
			margin-right: 5px;
			font-size: 13px;
			color: var(--color-text-secondary);
			overflow: hidden;
			text-overflow: ellipsis;
			white-space: nowrap;
		}

		&__search {
			margin: 0 2px 12px;
		}

		&__skill {
			margin-bottom: 9px;
			border-radius: 15px;
			border-width: 1px;
			border-style: solid;
			border-color: transparent;
			background-color: var(--color-bg-card);

			&--on {
				border-color: var(--color-primary);
				background-color: var(--color-brand-soft);
			}
		}

		&__skill-tx {
			flex: 1;
			min-width: 0;
			flex-direction: column;
		}

		&__skill-name {
			font-size: 14px;
			font-weight: 700;
			color: var(--color-text);
			overflow: hidden;
			text-overflow: ellipsis;
			white-space: nowrap;
		}

		&__skill-desc {
			margin-top: 4px;
			font-size: 11px;
			color: var(--color-text-tertiary);
			overflow: hidden;
			text-overflow: ellipsis;
			white-space: nowrap;
		}

		&__skill-check {
			margin-left: 12px;
		}

		&__conn {
			margin: 0 2px 8px;
			padding: 13px 14px;
			border-radius: 14px;
			border-width: 1px;
			border-style: solid;
			border-color: var(--color-border);
			background-color: var(--color-bg-card);
		}

		&__conn-icon {
			width: 40px;
			height: 40px;
			margin-right: 12px;
			border-radius: 12px;
			align-items: center;
			justify-content: center;
		}

		&__conn-sw {
			margin-left: 12px;
		}

		&__conn-tx {
			flex: 1;
			min-width: 0;
			flex-direction: column;
		}

		&__conn-name {
			font-size: 14px;
			font-weight: 700;
			color: var(--color-text);
		}

		&__conn-desc {
			margin-top: 3px;
			font-size: 12px;
			color: var(--color-text-tertiary);
			overflow: hidden;
			text-overflow: ellipsis;
			white-space: nowrap;
		}

		&__conn-tip {
			margin-top: 16px;
			padding: 0 18px 6px;
			font-size: 12px;
			line-height: 18px;
			text-align: center;
			color: var(--color-text-tertiary);
		}

		&__empty {
			padding-top: 24px;
			padding-bottom: 24px;
			font-size: 12px;
			text-align: center;
			color: var(--color-text-tertiary);
		}
	}
</style>
