<template>
	<view class="app-composer">
		<!-- 宽屏内容列：限宽居中由父级传 columnStyle，内部结构与窄屏完全一致 -->
		<view class="app-composer__col" :style="columnStyle">
		<!-- 字体图标缺 spark，附件 tag 图标暂缺 -->
		<rice-tag v-if="hasTag" v-show="!holding" class="app-composer__tag" type="primary" plain :text="tag"
			text-color="var(--color-primary)" text-size="11px" :custom-style="tagStyle"></rice-tag>

		<!-- 待发送附件 chips：选中即入列，点 × 移除；随下一条消息内联 base64 发送（v1.1） -->
		<view v-if="attachments.length > 0" v-show="!holding" class="app-composer__attaches">
			<view v-for="(att, ai) in attachments" :key="ai" class="app-composer__attach">
				<rice-icon :name="att.type === 'image' ? 'photo' : 'file-success'" size="13px" color="var(--color-text-secondary)" />
				<text class="app-composer__attach-name">{{ att.name }}</text>
				<view class="app-composer__attach-x" @click.stop="emit('remove-attach', ai)">
					<rice-icon name="cross" size="11px" color="var(--color-text-tertiary)" />
				</view>
			</view>
		</view>

		<!-- 录音态面板：波形 + 提示悬于输入条上方（设计稿形态二/三）。
			常驻节点用 v-show 显隐——按住手势期间做结构增删会打断原生触摸流，曾致上滑取消失灵、浮层滞留 -->
		<view v-show="holding" class="app-composer__rec">
			<app-voice-wave :active="holding" :error="canceling"></app-voice-wave>
			<text class="app-composer__rec-hint" :class="recHintClass">{{ recDisplay }}</text>
		</view>

		<!-- 收起态整条输入栏均可长按直接进录音：长按手势发生在中央节点上，录音态不销毁节点，move/end 连续派发。
			box 也挂 touch 系列：长按落在留白区时手势节点是 box；处理器均有 holding 幂等守卫，与 center 重复派发无副作用 -->
		<view class="app-composer__box" :class="boxClass" @click="onBoxClick" @longpress="onBoxLongPress"
			@touchmove="onTouchMove" @touchend="onTouchEnd" @touchcancel="onTouchCancel">
			<!-- 中央节点：文字/语音两形态共用同一节点。文字态点击展开、长按下录；语音态按住说话。
				子节点必须保持单 text 常驻（形态切换只改绑定，不做 v-if 分支切换）——
				长按下录瞬间若子树重建，原生触摸流会被掐断，滑动状态与松手收尾全部失灵。
				.stop 阻断冒泡，防止宿主 home__narrow 的右滑开抽屉手势层在录音手势中途抢走事件流 -->
			<view v-if="!expanded" class="app-composer__center" :class="centerClass" @longpress="onCenterLongPress"
				@touchstart="onTouchStart" @touchmove.stop="onTouchMove" @touchend.stop="onTouchEnd" @touchcancel.stop="onTouchCancel">
				<!-- 有草稿时最多展示 3 行（max-lines 截断），不再单行省略——收起态也要能看清自己写了什么；
					占位/按住说话仍单行。max-lines 是蒸汽模式 text 的组件属性（UCSS lines 已废弃，vapor 下 :lines/lines: 编译告警且不生效）；H5 端由 fake-text 的 line-clamp 兜底 -->
				<text v-show="!holding" :max-lines="hasText && !voiceMode ? 3 : 1"
					:class="voiceMode ? 'app-composer__hold-text' : (hasText ? 'app-composer__fake-text' : 'app-composer__fake-placeholder')">{{ voiceMode ? holdText : (hasText ? modelValue : placeholder) }}</text>
			</view>
			<!-- 多行输入：textarea 自动换行 + auto-height 随内容长高（上限 132px≈6 行，超出内部滚动）。
				旧实现是单行 input（原生控件不支持换行，长文只能横向滚动，用户看不全自己写了什么）。
				confirm-type 保持 send：软键盘回车即发送与旧版一致；换行靠自动折行，粘贴的 \n 原样保留 -->
			<!-- adjust-position=false：系统不再整页顶起（旧实现把整个画面推上去，hero/头部全被顶出屏）。
				键盘高度经 keyboardheightchange 上报，宿主在输入区下方垫等高占位，只抬输入区本身 -->
			<textarea v-if="expanded" :id="inputId" class="app-composer__input" v-model="text" :placeholder="placeholder"
				:placeholder-style="placeholderStyle" confirm-type="send" :adjust-position="false" :auto-height="true"
				:show-confirm-bar="false" :disable-default-padding="true" @focus="onFocus" @blur="onBlur"
				@keyboardheightchange="onKeyboardHeight" @confirm="onSend" />

			<!-- 圆形图标按钮手写 view 而不用 rice-button：此处不需要其文字/主题变体能力，
				且原生 view 的点击行为更可控；.stop 阻断冒泡，避免误触 __box 的展开 -->
			<!-- 语音模式左上：切回键盘 -->
			<view v-if="!expanded && voiceMode" v-show="!holding" class="app-composer__circ app-composer__circ--mic" @click.stop="exitVoiceMode">
				<text class="iconfont app-composer__mic-glyph">&#xe643;</text>
			</view>
			<view v-if="!expanded && !voiceMode && speechSupported" class="app-composer__circ app-composer__circ--mic" @click.stop="onVoiceClick">
				<rice-icon name="voice" size="20px" color="var(--color-text-secondary)" />
			</view>
			<!-- 回复中（收起态）：停止按钮顶替加号位，语音/文字形态一致；按住录音时隐藏 -->
			<view v-if="!expanded && processing" v-show="!holding" class="app-composer__circ app-composer__circ--plus app-composer__circ--stop"
				@click.stop="emit('stop')">
				<view class="app-composer__stop-square"></view>
			</view>
			<view v-if="!expanded && !processing" v-show="!holding" class="app-composer__circ app-composer__circ--plus" @click.stop="emit('open-plus')">
				<rice-icon name="plus" size="20px" color="var(--color-text-secondary)" />
			</view>

			<view v-if="expanded" class="app-composer__tools">
				<view v-if="speechSupported" class="app-composer__circ" @click.stop="onVoiceClick">
					<rice-icon name="voice" size="20px" color="var(--color-text-secondary)" />
				</view>
				<view class="app-composer__model" @click.stop="emit('open-model')">
					<text class="app-composer__model-text">{{ model }}</text>
					<rice-icon name="arrow-down" size="12px" color="var(--color-text-tertiary)" />
				</view>
				<!-- 新对话的工作空间选择（仅首页欢迎态 show-ws）：未选择=对话，选中挂对应空间 -->
				<view v-if="showWs" class="app-composer__model" @click.stop="emit('open-ws')">
					<text class="iconfont app-composer__ws-glyph">&#xe67c;</text>
					<text class="app-composer__model-text">{{ wsLabel }}</text>
					<rice-icon name="arrow-down" size="12px" color="var(--color-text-tertiary)" />
				</view>
				<view class="app-composer__spacer"></view>
				<!-- 设计稿：展开态有文字/附件时隐藏加号，只留发送 -->
				<view v-if="!canSend" class="app-composer__circ app-composer__circ--gap" @click.stop="emit('open-plus')">
					<rice-icon name="plus" size="20px" color="var(--color-text-secondary)" />
				</view>
				<!-- 回复中：发送按钮原位换成停止按钮，禁再次发送（对齐 uni-ai-x input-tool-bar）；
					字体图标暂缺 stop，以圆角方块 view 占位，待字体图标补全后替换 -->
				<view v-if="processing" class="app-composer__circ app-composer__circ--gap app-composer__circ--stop"
					@click.stop="emit('stop')">
					<view class="app-composer__stop-square"></view>
				</view>
				<view v-else class="app-composer__circ app-composer__circ--gap" :class="canSend ? 'app-composer__circ--send' : ''"
					@click.stop="onSend">
					<!-- 只挂 .iconfont：Web 端 iconfont.css 的 .icon-fasong:before 会与 text 内的码点重复出一个字形 -->
					<text class="iconfont" :class="canSend ? 'app-composer__icon--send' : ''">&#xe670;</text>
                </view>
			</view>
		</view>
		<!-- 键盘占位：adjust-position=false 后系统不推页面，这里垫出键盘高度，
			输入区被顶到键盘正上方，hero/消息流只在剩余空间内收缩，不再整屏上顶 -->
		<view v-if="keyboardHeight > 0" class="app-composer__kbd" :style="kbdStyle"></view>
		</view>

		<!-- 录音手势捕获层：按住期间浮满视口，手指滑出输入栏后 move/end 仍派发到本层，
			上滑变红/松开收尾才可靠；置尾保证盖在输入栏之上，处理器带 holding 幂等守卫；
			.stop 防止冒泡给宿主右滑手势层被中途抢流 -->
		<view v-show="holding" class="app-composer__gesture-mask" @touchmove.stop="onTouchMove" @touchend.stop="onTouchEnd"
			@touchcancel.stop="onTouchCancel"></view>
	</view>
</template>

<script setup lang="ts">
	import { computed, nextTick, onUnmounted, ref, watch } from 'vue'
	import type { ComputedRef, Ref, WritableComputedRef } from 'vue'
	import { i18n } from '@/locale/i18n.ts'
	import { isSpeechSupported, setSpeechLanguage, startSpeechSession, stopSpeechSession, cancelSpeechSession, openSpeechPermissionSettings } from '@/utils/speech-recognizer.uts'
	import type { SpeechStartResult } from '@/utils/speech-recognizer.uts'
	import { useLocale } from '@/hooks/useLocale.ts'
	import type { Locale } from '@/hooks/useLocale.ts'
	import AppVoiceWave from '@/components/app-voice-wave/app-voice-wave.uvue'
	import type { PendingAttachment } from '@/data/app-data'

	defineOptions({
		name: 'app-composer',
		styleIsolation: 'app-and-page'
	})

	const props = withDefaults(defineProps<{
		modelValue: string
		expanded: boolean
		model: string
		tag: string
		/** 当前会话回复中：发送按钮换停止按钮 */
		processing?: boolean
		/** 输入框节点 id，首页与对话页同栈时需各自唯一，聚焦用 */
		inputId?: string
		/** 宽屏内容列样式（width+margin-left）；窄屏传空串保持撑满 */
		columnStyle?: string
		/** 新对话欢迎态：工具行展示工作空间选择 chip（对话页不展示，会话归属已锁定） */
		showWs?: boolean
		/** 工作空间 chip 展示名（未选择=「对话」） */
		wsLabel?: string
		/** 待发送附件（v1.1 内联 base64）；chips 展示 + 仅附件也可发送 */
		attachments?: PendingAttachment[]
	}>(), {
		modelValue: '',
		expanded: false,
		model: '',
		tag: '',
		processing: false,
		inputId: 'app-composer-input',
		columnStyle: '',
		showWs: false,
		wsLabel: '',
		attachments: (): PendingAttachment[] => []
	})

	const emit = defineEmits<{
		(e: 'update:modelValue', value: string): void
		(e: 'expand'): void
		(e: 'collapse'): void
		(e: 'send', text: string): void
		(e: 'stop'): void
		(e: 'open-model'): void
		(e: 'open-plus'): void
		(e: 'open-ws'): void
		(e: 'remove-attach', index: number): void
	}>()

	/** 上滑取消的位移阈值（px） */
	const SWIPE_THRESHOLD = 60
	/** 单段识别上限：系统引擎到时自动收尾并回吐已有结果 */
	const MAX_DURATION_MS = 60000
	/** 短于该时长视为误触，丢弃 */
	const MIN_DURATION_MS = 600
	/** 按住 watchdog：touchend/touchcancel 丢失时强制结束识别会话，避免浮层滞留 */
	const HOLD_WATCHDOG_MS = MAX_DURATION_MS + 5000

	const text: WritableComputedRef<string> = computed<string>({
		get: (): string => props.modelValue,
		set: (value: string): void => emit('update:modelValue', value)
	})

	const hasText: ComputedRef<boolean> = computed<boolean>((): boolean => props.modelValue.trim().length > 0)
	/** 可发送 = 有文字或有附件（仅附件也合法：内核附件注入不依赖正文） */
	const canSend: ComputedRef<boolean> = computed<boolean>((): boolean => hasText.value || props.attachments.length > 0)
	const hasTag: ComputedRef<boolean> = computed<boolean>((): boolean => props.tag.length > 0)

	// 识别语言跟随应用语言：应用 locale → 系统引擎认的 BCP-47 标签，注入 .uts 接入层
	// （uni.getLocale 在 uni-app x 蒸汽模式不存在，.uts 也不 import 应用层 .ts，语言由本宿主决定）
	const { currentLocale } = useLocale()
	const SPEECH_LOCALE_MAP = new Map<string, string>([
		['zh-Hans', 'zh-CN'], ['zh-Hant', 'zh-TW'], ['en', 'en-US'], ['ja', 'ja-JP'],
		['ru', 'ru-RU'], ['de', 'de-DE'], ['es', 'es-ES'], ['fr', 'fr-FR'],
		['pt', 'pt-PT'], ['el', 'el-GR'], ['ro', 'ro-RO'], ['vi', 'vi-VN']
	])
	function syncSpeechLanguage(): void {
		const mapped = SPEECH_LOCALE_MAP.get(currentLocale.value)
		setSpeechLanguage(mapped != null ? mapped : 'zh-CN')
	}
	syncSpeechLanguage()

	// 语音能力门控：设备无引擎/平台不支持/语言不支持时整体隐藏语音入口（麦克风按钮、长按直录），
	// 而不是让用户点击后必报错。探测结果按语言缓存（见 speech-recognizer）；
	// 运行时 unsupported（鸿蒙非大陆机型等）经失败分支即时翻转隐藏。
	// ref 而非 computed：探测含原生调用，只在挂载/语言切换/展开态变化/会话失败时刷新，避免每次渲染都打
	const speechSupported: Ref<boolean> = ref<boolean>(isSpeechSupported())

	// 设置页切语言即时生效：重注入语言并重探测（鸿蒙「仅中文」、iOS 各语言引擎可用性不同）
	watch(currentLocale, (_next: Locale): void => {
		syncSpeechLanguage()
		speechSupported.value = isSpeechSupported()
		if (!speechSupported.value) {
			voiceMode.value = false
			voiceFromLongPress.value = false
		}
	})

	// 语音模式：由麦克风按钮/输入框长按进出；进入时若在展开态，先让父级收起
	const voiceMode: Ref<boolean> = ref<boolean>(false)
	// 长按直录标记：本次录音会话结束后回到文字形态（麦克风进入的语音形态不受影响）
	const voiceFromLongPress: Ref<boolean> = ref<boolean>(false)
	// 录音态与取消态：holding 期间节点只换色，不做结构变更
	const holding: Ref<boolean> = ref<boolean>(false)
	const canceling: Ref<boolean> = ref<boolean>(false)
	const touchStartY: Ref<number> = ref<number>(0)
	let holdWatchdog: number = 0
	// 实时识别的中间结果（边说边出字）；会话代号防串：上一会话迟到的收尾不作用于新会话
	const partialText: Ref<string> = ref<string>('')
	let speechGeneration = 0
	let holdStartedAt = 0

	// 有草稿的收起态：中央节点随内容长高（1~3 行），不再钉死 36px 单行截断。
	// 语音形态（含按住录音）恒单行：按住期间改几何会打断原生触摸流（既有纪律）
	const centerClass: ComputedRef<string> = computed<string>((): string => {
		let cls: string = speechSupported.value ? '' : 'app-composer__center--nomic'
		if (hasText.value && !voiceMode.value && !holding.value) {
			cls = cls.length > 0 ? cls + ' app-composer__center--draft' : 'app-composer__center--draft'
		}
		return cls
	})

	const boxClass: ComputedRef<string> = computed<string>((): string => {
		// 有草稿时收起态随内容长高（配合 center--draft 的 1~3 行）；
		// 录音态叠在其后只换配色，几何仍由 draft 决定，避免重建节点打断手势
		const base: string = props.expanded ? 'app-composer__box--open' : (hasText.value ? 'app-composer__box--draft' : '')
		if (voiceMode.value && holding.value) {
			const record: string = canceling.value ? 'app-composer__box--record app-composer__box--record-error' : 'app-composer__box--record'
			return base.length > 0 ? base + ' ' + record : record
		}
		return base
	})

	const placeholder: ComputedRef<string> = computed<string>((): string => {
		return i18n.global.t(props.expanded ? 'home.placeholderExpanded' : 'home.placeholder')
	})

	const placeholderStyle: ComputedRef<string> = computed<string>((): string => {
		return 'color:var(--color-text-tertiary);'
	})

	const holdText: ComputedRef<string> = computed<string>((): string => i18n.global.t('home.voice.holdToTalk'))

	const recHint: ComputedRef<string> = computed<string>((): string => {
		return i18n.global.t(canceling.value ? 'home.voice.releaseCancel' : 'home.voice.releaseSend')
	})

	// 边说边出字：有中间结果时录音面板显示识别文本（单行截断），否则显示操作提示
	const recDisplay: ComputedRef<string> = computed<string>((): string => {
		if (!canceling.value && partialText.value.length > 0) return partialText.value
		return recHint.value
	})

	const recHintClass: ComputedRef<string> = computed<string>((): string => {
		if (canceling.value) return 'app-composer__rec-hint--error'
		if (partialText.value.length > 0) return 'app-composer__rec-hint--partial'
		return ''
	})

	const tagStyle: UTSJSONObject = {
		height: '26px',
		padding: '0 9px',
		border: 'none',
		'border-radius': '9px',
		'background-color': 'var(--color-brand-soft)'
	}

	// 展开态渲染出真 input 后聚焦；输入框是同一节点只改布局，避免重建导致失焦、键盘收起。
	// 同时刷新语音能力缓存（语言可能已在设置页切换，探测按语言缓存见 speech-recognizer）
	watch((): boolean => props.expanded, (expanded: boolean): void => {
		speechSupported.value = isSpeechSupported()
		if (!expanded) {
			// 收起即清键盘占位：textarea 随 v-if 卸载不一定派发 blur，占位滞留会把输入区顶在半空
			inputFocused = false
			rawKbd = 0
			focusWindowHeight = -1
			keyboardHeight.value = 0
			return
		}
		nextTick((): void => {
			const input = uni.getElementById(props.inputId)
			if (input != null) input.focus()
		})
	})

	function t(key: string): string {
		return i18n.global.t(key)
	}

	/**
	 * 语音失败统一提示：权限被永久拒绝（勾「不再询问」/iOS 拒绝过）时系统不会再弹授权框，
	 * toast「检查权限」用户无从下手——弹引导框给「去设置」直达本应用权限页；其余失败仍走 toast。
	 * 引导框同一时间只弹一个（按住失败与松手收尾两条链路可能先后到达）。
	 */
	let permDialogShowing = false
	function showSpeechError(res: SpeechStartResult): void {
		if (res.permissionBlocked) {
			if (permDialogShowing) return
			permDialogShowing = true
			uni.showModal({
				title: t('home.voice.permTitle'),
				content: t('home.voice.permContent'),
				confirmText: t('home.voice.permSettings'),
				cancelText: t('home.voice.permCancel'),
				success: (r: ShowModalSuccess): void => {
					if (r.confirm) openSpeechPermissionSettings()
				},
				complete: (): void => {
					permDialogShowing = false
				}
			})
			return
		}
		if (res.errorKey != null) uni.showToast({ title: t(res.errorKey!), icon: 'none' })
	}

	/* ---- 键盘局部抬升：adjust-position=false 后由本组件接管。
	        keyboardheightchange 上报键盘高度 → 输入区下方垫等高占位；
	        blur/收起/卸载一律清零，占位绝不滞留把输入区顶在半空 ---- */
	const keyboardHeight: Ref<number> = ref<number>(0)
	// 聚焦标志：blur/收起后个别机型还会补发一帧非零 keyboardheightchange（派发顺序不保证），
	// 无条件采纳会把已清零的占位重新顶起来且无人再清——非聚焦态只接受 0 帧
	let inputFocused: boolean = false
	// 【双抬真因 · 2026-11-24 三轮报障「点输入框后停止按钮被遮挡」】部分机型
	// （华为 EMUI 等）在 adjust-position=false 下仍压缩 WebView 视口（等效
	// adjustResize）：页面已变矮、输入区本来就在键盘上方，再垫 keyboardHeight
	// 占位 = 双倍抬升，输入盒被顶进消息区/顶出可视范围（截图停止按钮被裁）。
	// 对策：聚焦瞬间记窗口高度基线，键盘帧到达时重读——视口已缩（≥半个键盘高）
	// 则占位归零，只有视口未缩的机型才垫占位；resize 迟到的机型由 onWindowResize 复核。
	let focusWindowHeight: number = -1
	let rawKbd: number = 0
	const kbdStyle: ComputedRef<string> = computed<string>((): string => {
		return 'height:' + keyboardHeight.value.toString() + 'px;'
	})

	/** 视口已被键盘压缩 → 占位归零（防双抬）；未缩才垫 rawKbd */
	function applyKbdHeight(): void {
		if (!inputFocused || rawKbd <= 0) { keyboardHeight.value = 0; return }
		if (focusWindowHeight > 0) {
			const now: number = uni.getWindowInfo().windowHeight
			// 容差：状态栏/导航条微抖不算 resize；缩了至少 max(40, 半个键盘高) 才认定 resize 机型
			if (focusWindowHeight - now > Math.max(40, rawKbd / 2)) { keyboardHeight.value = 0; return }
		}
		keyboardHeight.value = rawKbd
	}

	function onKeyboardHeight(e: UniInputKeyboardHeightChangeEvent): void {
		if (!inputFocused && e.detail.height > 0) return
		rawKbd = e.detail.height
		applyKbdHeight()
	}

	// resize 可能迟于 keyboardheightchange：窗口高度变化时复核占位。
	// uni.onWindowResize 仅 Web/微信可用（APP 端无全局监听，见 useViewport 头注释）；
	// APP 端 resize 机型的迟到压缩由 applyKbdHeight 的下一帧键盘事件/blur 兜底，
	// 且 keyboardheightchange 在 resize 完成后必然还有一帧终值（高度稳定帧）。
	// #ifdef WEB || MP-WEIXIN
	uni.onWindowResize((_res: UniNamespace.WindowResizeResult): void => {
		if (inputFocused) applyKbdHeight()
	})
	// #endif

	function onBlur(): void {
		inputFocused = false
		rawKbd = 0
		focusWindowHeight = -1
		keyboardHeight.value = 0
	}

	function onFocus(): void {
		inputFocused = true
		focusWindowHeight = uni.getWindowInfo().windowHeight
		emit('expand')
	}

	function onBoxClick(): void {
		// 长按起录后个别端不派发 touchend，click 是释放兜底信号；
		// touchend 正常收尾时 holding 已复位，这里不会命中，天然幂等
		if (holding.value) {
			holding.value = false
			stopHoldWatchdog()
			finishRecord(canceling.value)
			canceling.value = false
			return
		}
		// 语音模式点输入条不展开为文字输入，避免打断录音模式
		if (voiceMode.value) return
		emit('expand')
	}

	function onSend(): void {
		emit('send', props.modelValue)
	}

	function onVoiceClick(): void {
		if (!speechSupported.value) return
		voiceMode.value = true
		if (props.expanded) emit('collapse')
	}

	function exitVoiceMode(): void {
		voiceMode.value = false
	}

	/** 长按输入框：直接切语音形态并开始录音（长按手势已在本节点，move/end 连续派发） */
	function onCenterLongPress(): void {
		if (props.expanded || voiceMode.value || holding.value) return
		// 不支持时长按静默忽略（入口已隐藏，这里是兜底守卫），不弹提示打扰
		if (!speechSupported.value) return
		voiceMode.value = true
		// 长按直录是一次性会话：结束后回文字形态；麦克风进入的语音形态则保持
		voiceFromLongPress.value = true
		beginHold()
	}

	function onBoxLongPress(): void {
		// 展开态是可编辑真 input，长按留给系统文本操作；语音模式下长按无意义
		if (props.expanded || voiceMode.value || holding.value) return
		if (!speechSupported.value) return
		voiceMode.value = true
		voiceFromLongPress.value = true
		beginHold()
	}

	function startHoldWatchdog(): void {
		stopHoldWatchdog()
		holdWatchdog = setTimeout((): void => {
			forceEndHold()
		}, HOLD_WATCHDOG_MS)
	}

	function stopHoldWatchdog(): void {
		if (holdWatchdog != 0) {
			clearTimeout(holdWatchdog)
			holdWatchdog = 0
		}
	}

	/** 兜底：手势事件丢失（如系统弹窗/页面切换吞掉 touchend）时强制收尾，浮层不滞留 */
	function forceEndHold(): void {
		if (!holding.value) return
		holding.value = false
		canceling.value = false
		finishRecord(true)
	}

	function onTouchStart(e: TouchEvent): void {
		// 起点坐标任何形态都要记：长按起录发生在 touchstart 之后，届时手势系统不再派发 touchstart
		if (e.touches.length > 0) touchStartY.value = e.touches[0].clientY
		// 文字形态下 touch 系列不介入，把点击/长按让给 click/longpress 手势
		if (!voiceMode.value || holding.value) return
		beginHold()
	}

	function beginHold(): void {
		holding.value = true
		canceling.value = false
		partialText.value = ''
		holdStartedAt = Date.now()
		startHoldWatchdog()
		const gen = ++speechGeneration
		// 起录前同步一次语言（设置页可能已切换），识别语言始终跟随当前应用语言
		syncSpeechLanguage()
		// 按住即实时识别：权限弹窗在插件内拉起，拒绝/失败经同一 Promise 终态落地。
		// 收尾统一走 finishRecord（取消判定/过短/发送都在那里），此处只暂存终态结果并唤醒等待方
		sessionPromise = startSpeechSession(MAX_DURATION_MS, (text: string): void => {
			if (gen != speechGeneration || !holding.value) return
			partialText.value = text
		})
		sessionPromise.then((res: SpeechStartResult): void => {
			if (gen != speechGeneration) return
			pendingResult = res
			const waiter = resultWaiter
			resultWaiter = null
			if (waiter != null) {
				waiter(res)
				return
			}
			if (!holding.value) return
			// 无人在等且仍按住：要么是按住期间失败（权限拒绝/无引擎），要么是单段到时自动收尾。
			// 失败立即复位并提示；到时收尾走正常发送链路（取消态下静默丢弃）
			if (!res.ok) {
				holding.value = false
				canceling.value = false
				stopHoldWatchdog()
				partialText.value = ''
				sessionPromise = null
				pendingResult = null
				showSpeechError(res)
				// 设备级 unsupported 已落缓存：即时隐藏语音入口并退出语音形态
				speechSupported.value = isSpeechSupported()
				if (!speechSupported.value) {
					voiceMode.value = false
					voiceFromLongPress.value = false
				}
				return
			}
			const wasCanceling = canceling.value
			holding.value = false
			canceling.value = false
			stopHoldWatchdog()
			finishRecord(wasCanceling)
		})
	}

	// 会话终态的暂存与唤醒：finishRecord 松手后 await；结果先到（权限拒绝/引擎秒失败）则直接消费
	let sessionPromise: Promise<SpeechStartResult> | null = null
	let pendingResult: SpeechStartResult | null = null
	let resultWaiter: ((res: SpeechStartResult) => void) | null = null

	function awaitSpeechResult(): Promise<SpeechStartResult> {
		const done = pendingResult
		if (done != null) {
			pendingResult = null
			return Promise.resolve<SpeechStartResult>(done)
		}
		return new Promise<SpeechStartResult>((resolve: (res: SpeechStartResult) => void) => {
			resultWaiter = resolve
		})
	}

	/** 放弃当前会话（取消/失败后清场）：代号自增使迟到回调失效，引擎静默释放 */
	function abandonSpeech(): void {
		speechGeneration++
		pendingResult = null
		resultWaiter = null
		sessionPromise = null
		partialText.value = ''
		cancelSpeechSession()
	}

	// 页面切换/组件销毁不能吞掉手势收尾：按住中卸载按取消清场，麦克风绝不滞留占用
	onUnmounted((): void => {
		stopHoldWatchdog()
		abandonSpeech()
		inputFocused = false
		rawKbd = 0
		focusWindowHeight = -1
		keyboardHeight.value = 0
	})

	function onTouchMove(e: TouchEvent): void {
		if (!holding.value || e.touches.length == 0) return
		const deltaY: number = e.touches[0].clientY - touchStartY.value
		// 上滑进取消态，下滑回发送态
		canceling.value = deltaY < -SWIPE_THRESHOLD
	}

	function onTouchEnd(e: TouchEvent): void {
		if (!holding.value) return
		// 收尾时以 changedTouches 的终点复算一次取消态，兜住最后一程 touchmove 缺失
		if (!canceling.value && e.changedTouches.length > 0) {
			const deltaY: number = e.changedTouches[0].clientY - touchStartY.value
			canceling.value = deltaY < -SWIPE_THRESHOLD
		}
		holding.value = false
		stopHoldWatchdog()
		finishRecord(canceling.value)
		canceling.value = false
	}

	/** 系统抢占手势（授权弹窗、来电等）：按取消处理，静默丢弃 */
	function onTouchCancel(): void {
		if (!holding.value) return
		holding.value = false
		stopHoldWatchdog()
		finishRecord(true)
		canceling.value = false
	}

	async function finishRecord(canceled: boolean): Promise<void> {
		// 长按直录的会话一旦收尾就回文字形态（含取消/过短/失败）；语音模式（麦克风进入）保持
		if (voiceFromLongPress.value) {
			voiceFromLongPress.value = false
			voiceMode.value = false
		}
		// 取消：静默放弃识别会话，不提示
		if (canceled) {
			holdStartedAt = 0
			abandonSpeech()
			return
		}
		const duration = holdStartedAt > 0 ? Date.now() - holdStartedAt : 0
		holdStartedAt = 0
		if (duration < MIN_DURATION_MS) {
			// 首次按住被系统授权弹窗打断（touchcancel 秒收尾）时用户还没说话，不按「太短」打扰
			const showToast = sessionPromise != null && duration >= 200
			abandonSpeech()
			if (showToast) uni.showToast({ title: t('home.voice.tooShort'), icon: 'none' })
			return
		}
		if (sessionPromise == null) return
		// 通知引擎停止采集；最终结果从会话 Promise 落地（插件 3s + 接入层 5s 双兜底，绝不悬挂）
		stopSpeechSession()
		const res: SpeechStartResult = await awaitSpeechResult()
		sessionPromise = null
		partialText.value = ''
		if (!res.ok) {
			showSpeechError(res)
			// 设备级 unsupported 已落缓存：即时隐藏语音入口并退出语音形态
			speechSupported.value = isSpeechSupported()
			if (!speechSupported.value) {
				voiceMode.value = false
				voiceFromLongPress.value = false
			}
			return
		}
		const content: string = res.text != null ? res.text!.trim() : ''
		if (content.length === 0) {
			uni.showToast({ title: t('home.voice.recognizeEmpty'), icon: 'none' })
			return
		}
		// 识别文本走既有 send 链路（trim/空判由父级统一兜底）；输入形态保持语音，不自动切回文字
		emit('send', content)
	}
</script>

<style lang="scss">
	.app-composer {
		/* 展开态的空白点击层是绝对定位节点，输入区需要同级定位才能盖在它上面接收点击 */
		position: relative;
		padding: 0 18px 26px;

		/* 宽屏内容列容器：columnStyle 为空时默认拉伸占满，窄屏零回归 */
		&__col {
			flex-direction: column;
		}

		&__tag {
			margin: 0 4px 8px;
		}

		// 待发送附件 chips：横向可换行；点 × 移除
		&__attaches {
			flex-direction: row;
			flex-wrap: wrap;
			margin: 0 4px 8px;
		}

		&__attach {
			flex-direction: row;
			align-items: center;
			background-color: var(--color-fill-secondary);
			border-radius: 8px;
			padding: 4px 8px;
			margin: 0 6px 6px 0;
			max-width: 220px;
		}

		&__attach-name {
			font-size: 12px;
			color: var(--color-text-secondary);
			margin-left: 4px;
			max-width: 150px;
			overflow: hidden;
			text-overflow: ellipsis;
			white-space: nowrap;
		}

		&__attach-x {
			margin-left: 6px;
			padding: 2px;
		}

		// 录音态面板：波形在上、提示在下（UCSS 无 gap，用 margin）
		&__rec {
			flex-direction: column;
			align-items: center;
			margin-bottom: 10px;
		}

		&__rec-hint {
			margin-top: 10px;
			font-size: 13px;
			color: var(--color-text-secondary);
			max-width: 300px;
			overflow: hidden;
			text-overflow: ellipsis;
			white-space: nowrap;

			&--error {
				color: var(--color-error);
			}

			&--partial {
				color: var(--color-text);
			}
		}

		&__box {
			position: relative;
			flex-direction: row;
			align-items: center;
			height: 56px;
			padding-left: 14px;
			padding-right: 10px;
			border-radius: 22px;
			border-width: 1px;
			border-style: solid;
			border-color: var(--color-border);
			background-color: var(--color-bg-card);

			&--open {
				height: auto;
				flex-direction: column;
				align-items: stretch;
				padding: 10px 12px;
				border-radius: 20px;
			}

			// 收起态有草稿：整条随内容长高（1~3 行），不再钉死 56px 把多行草稿裁掉
			&--draft {
				height: auto;
				min-height: 56px;
				padding-top: 8px;
				padding-bottom: 8px;
			}

			// 录音态：整条转主色实底，取消态转危险红（对齐设计稿形态二/三）；只动配色不动几何
			&--record {
				border-color: var(--color-primary);
				background-color: var(--color-primary);
			}

			&--record-error {
				border-color: var(--color-error);
				background-color: var(--color-error);
			}
		}

		// 中央节点：文字形态是假输入（点击展开、长按下录），语音形态是按住说话热区
		&__center {
			flex: 1;
			height: 36px;
			margin-left: 45px;
			margin-right: 45px;
			flex-direction: column;
			justify-content: center;
			overflow: hidden;

			// 语音入口隐藏时左侧没有麦克风按钮，收窄左边距避免占位文字悬空
			&--nomic {
				margin-left: 4px;
			}

			// 有草稿：高度放开到 3 行（20px 行高 × 3 + 上下留白），随内容自适应
			&--draft {
				height: auto;
				min-height: 36px;
				max-height: 68px;
				padding: 6px 0;
			}
		}

		&__fake-text {
			/* 草稿预览最多 3 行（模板 :max-lines=3 管 App 端；下面 #ifndef APP 是 H5 兜底），
			   不再单行省略——收起态也要能看清自己写了什么 */
			font-size: 14px;
			line-height: 20px;
			color: var(--color-text);
			overflow: hidden;
			text-overflow: ellipsis;
			/* Web/H5 兜底：text 外层有组件包装，须选择器下探一层 line-clamp 才生效（uni-app x 官方 text 文档）。
			   APP 端 UCSS 不认这些属性，条件编译排除，避免非标准属性告警 */
			/* #ifndef APP */
			& uni-text {
				overflow: hidden;
				display: -webkit-box;
				-webkit-box-orient: vertical;
				-webkit-line-clamp: 3;
			}
			/* #endif */
		}

		&__fake-placeholder {
			font-size: 14px;
			color: var(--color-text-tertiary);
			overflow: hidden;
			text-overflow: ellipsis;
			white-space: nowrap;
		}

		&__hold-text {
			font-size: 14px;
			font-weight: 600;
			text-align: center;
			color: var(--color-text-secondary);
		}

		&__input {
			/* 多行 textarea：不设 flex:1（展开态 box 是 column，会把输入区拉满整盒）；
			   min-height 保持单行时的视觉高度，auto-height 随内容长高，max-height 封顶后内部滚动。
			   line-height 显式声明：auto-height 的行数换算依赖它，缺省时各端行高不一。 */
			min-height: 38px;
			max-height: 132px;
			margin-left: 0;
			margin-right: 0;
			padding: 8px 4px;
			font-size: 14px;
			line-height: 20px;
			color: var(--color-text);
		}

		&__circ {
			width: 36px;
			height: 36px;
			align-items: center;
			justify-content: center;
			border-radius: 18px;
			background-color: var(--color-bg-hover);

			// 展开态工具行内相邻按钮的间距（UCSS 无 gap，用 margin）
			&--gap {
				margin-left: 8px;
			}

			&--send {
				background-color: var(--color-primary);
			}

			// 停止按钮与发送同位同尺寸，底色取中性强色；内部方块即停止符号（图标补全前的占位）
			&--stop {
				background-color: var(--color-text);
			}

			&--mic {
				position: absolute;
				left: 14px;
				top: 10px;
			}

			&--plus {
				position: absolute;
				right: 10px;
				top: 10px;
			}
		}

		&__tools {
			flex-direction: row;
			align-items: center;
			height: 36px;
			margin-top: 8px;
		}

		&__model {
			flex-direction: row;
			align-items: center;
			height: 32px;
			margin-left: 8px;
			margin-right: 8px;
			padding-left: 11px;
			padding-right: 11px;
			border-radius: 11px;
			background-color: var(--color-bg-hover);
		}

		&__model-text {
			margin-right: 5px;
			font-size: 12px;
			font-weight: 700;
			color: var(--color-text-secondary);
		}

		// 工作空间 chip 的文件夹图标（iconfont 码点），颜色字号显式声明
		&__ws-glyph {
			margin-right: 5px;
			font-size: 12px;
			color: var(--color-text-secondary);
		}

		// 键盘占位：高度行内注入（keyboardheightchange 上报值），透明不拦视觉
		&__kbd {
			width: 100%;
		}

		&__spacer {
			flex: 1;
		}

		/* UCSS 无样式继承，图标色需显式声明；反色文本取主题变量 */
		&__icon--send {
			color: var(--color-text-inverse);
		}

		/* 语音模式左上「切回键盘」的字体图标（iconfont 码点），字号对齐原 rice-icon 的 20px */
		&__mic-glyph {
			font-size: 20px;
			color: var(--color-text-secondary);
		}

		// 停止符号：圆按钮内的圆角小方块
		&__stop-square {
			width: 11px;
			height: 11px;
			border-radius: 2.5px;
			background-color: var(--color-bg-card);
		}

		// 录音手势捕获层：transparent 不拦视觉，fixed 浮满视口（项目内 app-popup 同款定位方式）
		&__gesture-mask {
			position: fixed;
			left: 0;
			right: 0;
			top: 0;
			bottom: 0;
			z-index: 999;
			background-color: transparent;
		}
	}
</style>
