			padding-left: 11px;
			padding-right: 11px;
			border-radius: 11px;
			background-color: var(--color-bg-hover);
		}

		&__model-text {
			margin-right: 5px;
			font-size: 12px;
			font-weight: 700;
			color: var(--color-text-secondary);
		}

		&__spacer {
			flex: 1;
		}

		/* UCSS 无样式继承，图标色需显式声明；反色文本取主题变量 */
		&__icon--send {
			color: var(--color-text-inverse);
		}

		/* 语音模式左上「切回键盘」的字体图标（iconfont 码点），字号对齐原 rice-icon 的 20px */
		&__mic-glyph {
			font-size: 20px;
			color: var(--color-text-secondary);
		}

		// 停止符号：圆按钮内的圆角小方块
		&__stop-square {
			width: 11px;
			height: 11px;
			border-radius: 2.5px;
			background-color: var(--color-bg-card);
		}

		// 录音手势捕获层：transparent 不拦视觉，fixed 浮满视口（项目内 app-popup 同款定位方式）
		&__gesture-mask {
			position: fixed;
			left: 0;
			right: 0;
			top: 0;
			bottom: 0;
			z-index: 999;
			background-color: transparent;
		}
	}
</style>
