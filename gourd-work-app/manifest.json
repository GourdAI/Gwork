{
	"name": "GWork",
	"appid": "__UNI__55E260E",
	"description": "",
	"versionName": "0.0.1",
	"versionCode": "1",
	"uni-app-x": {
		"vapor": true,
		"styleIsolationVersion": "2",
		"vapor-render-target": "bytecode",
		"vapor-default-script-lang": "ts"
	},
	/* 快应用特有相关 */
	"quickapp": {},
	/* 小程序特有相关 */
	"mp-weixin": {
		"appid": "",
		"setting": {
			"urlCheck": false
		},
		"usingComponents": true
	},
	"mp-alipay": {
		"usingComponents": true
	},
	"mp-baidu": {
		"usingComponents": true
	},
	"mp-toutiao": {
		"usingComponents": true
	},
	"uniStatistics": {
		"enable": false
	},
	"vueVersion": "3",
	"app": {
		"defaultAppTheme": "auto",
		"distribute": {
			"icons": {
				"android": {
					"hdpi": "",
					"xhdpi": "",
					"xxhdpi": "",
					"xxxhdpi": ""
				}
			}
		}
	},
	"app-android": {
		"distribute": {
			// 录音权限：gwork-speech 系统语音识别依赖；运行时授权由插件内 UTSAndroid.requestSystemPermission 拉起。
			// 必须放在 distribute 下（官方 schema：app-android.distribute.permissions）——
			// 曾错放 app-android.permissions 顶层，云打包静默忽略，APK 缺 RECORD_AUDIO：
			// 系统对未声明权限直接拒绝且不弹授权框，语音每次都报「麦克风不可用」
			"permissions": [
				"android.permission.RECORD_AUDIO"
			],
			// 只打 64 位 ARM：2019 年后机型全是 arm64。
			// 不显式声明时云打包默认带 armeabi-v7a 运行时（每 ABI 数 MB），是 APK 虚胖的来源之一
			"abiFilters": [
				"arm64-v8a"
			],
			"modules": {},
			"icons": {
				"hdpi": "static/logos/logo_72x72.png",
				"xhdpi": "static/logos/logo_96x96.png",
				"xxhdpi": "static/logos/logo_144x144.png",
				"xxxhdpi": "static/logos/logo_192x192.png"
			},
			"splashScreens": {
				"default": {}
			}
		}
	},
	"app-ios": {
		"distribute": {
			"modules": {},
			// iPad 原生支持：universal 同时支持 iPhone/iPad；不设则 iPhone 应用在 iPad 上以兼容模式跑
			"devices": "universal",
			// false = 允许 iPad 分屏（Split View / Slide Over），窗口尺寸变化由 useViewport 响应
			"UIRequiresFullScreen": false,
			"icons": {
				"appstore": "static/logos/logo_1024x1024.png"
			},
			"splashScreens": {}
		}
	},
	"web": {
		"router": {
			"mode": ""
		}
	}
}