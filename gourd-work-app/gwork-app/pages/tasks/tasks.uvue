		width: 60px;
		height: 60px;
		border-radius: $gw-radius-pill;
		justify-content: center;
		align-items: center;
	}
	.gw-menu-line {
		width: 24px;
		height: 3px;
		border-radius: 2px;
		margin: 3px 0;
	}
	.gw-head-title-wrap {
		margin-left: 16px;
		justify-content: center;
	}
	.gw-head-brand-row {
		flex-direction: row;
		align-items: center;
	}
	.gw-head-brand-logo {
		width: 30px;
		height: 30px;
		border-radius: 7px;
		margin-right: 8px;
	}
	.gw-head-title {
		font-size: 24px;
		font-weight: 700;
	}
	.gw-head-sub {
		flex-direction: row;
		align-items: center;
		margin-top: 2px;
	}
	.gw-head-cloud { font-size: 15px; margin-right: 5px; }
	.gw-head-sub-text { font-size: 15px; }
	.gw-head-chevron { font-size: 17px; margin-left: 6px; }

	.gw-home-main {
		flex: 1;
		min-height: 0;
		align-items: flex-start;
		justify-content: center;
		padding: 0 $gw-page-pad;
	}
	.gw-home-robot {
		width: 150px;
		height: 145px;
		margin-bottom: 14px;
	}
	.gw-home-welcome {
		font-size: 30px;
		font-weight: 800;
		line-height: 40px;
		margin-bottom: 22px;
	}
	.gw-home-suggests {
		align-items: flex-start;
		margin-bottom: 14px;
	}
	.gw-suggest {
		flex-direction: row;
		align-items: center;
		border-width: 1px;
		border-style: solid;
		border-radius: $gw-radius-pill;
		padding: 11px 18px;
		margin-bottom: 10px;
	}
	.gw-suggest-icon { font-size: 17px; margin-right: 9px; }
	.gw-suggest-label { font-size: 16px; }
	.gw-home-refresh {
		flex-direction: row;
		align-items: center;
		border-radius: $gw-radius-pill;
		padding: 9px 16px;
	}
	.gw-refresh-icon { font-size: 19px; margin-right: 8px; }
	.gw-refresh-text { font-size: 15px; }

	.gw-home-input-area {
		padding: 8px 16px 0;
		flex-shrink: 0;
	}
	.gw-input-card {
		border-radius: 28px;
		padding: 0 20px;
		min-height: 62px;
		justify-content: center;
	}
	.gw-input-card-active { min-height: 132px; padding-top: 16px; padding-bottom: 12px; }
	.gw-input-idle-row { flex-direction: row; align-items: center; height: 62px; }
	.gw-input-voice { font-size: 20px; width: 40px; }
	.gw-input-idle { flex: 1; height: 60px; font-size: 16px; }
	.gw-input-placeholder { color: $gw-muted; }
	.gw-input-plus { font-size: 27px; width: 40px; text-align: right; }
	.gw-input-active-wrap { flex-direction: column; justify-content: space-between; height: 120px; }
	.gw-input-active { height: 48px; font-size: 17px; }
	.gw-input-toolbar { flex-direction: row; align-items: center; height: 48px; }
	.gw-model-select { flex-direction: row; align-items: center; margin-left: 4px; }
	.gw-model-dot { font-size: 17px; margin-right: 6px; }
	.gw-model-name { font-size: 16px; }
	.gw-model-arrow { font-size: 17px; margin-left: 4px; }
	.gw-send-btn {
		width: 48px;
		height: 48px;
		border-radius: $gw-radius-pill;
		justify-content: center;
		align-items: center;
		margin-left: 4px;
	}
	.gw-send-arrow { font-size: 18px; }

	/* 面板层 */
	.gw-scrim { position: absolute; top: 0; right: 0; bottom: 0; left: 0; }
	.gw-sheet {
		position: absolute;
		left: 0;
		right: 0;
		bottom: 0;
		border-top-left-radius: $gw-radius-sheet;
		border-top-right-radius: $gw-radius-sheet;
		padding: 22px $gw-page-pad 32px;
	}
	.gw-sheet-handle { width: 56px; height: 5px; border-radius: 3px; align-self: center; margin-bottom: 16px; }
	.gw-sheet-head { flex-direction: row; align-items: center; justify-content: space-between; margin-bottom: 18px; }
	.gw-sheet-title { font-size: 21px; font-weight: 700; }
	.gw-sheet-close { font-size: 26px; padding: 0 6px; }
	.gw-sheet-group { border-radius: $gw-radius-card; padding: 0 16px; }
	.gw-device-row { flex-direction: row; align-items: center; height: 66px; position: relative; }
	.gw-device-icon { font-size: 24px; margin-right: 14px; }
	.gw-device-label { font-size: 18px; font-weight: 600; flex: 1; }
	.gw-device-offline { font-size: 13px; border-radius: 6px; padding: 3px 8px; margin-right: 10px; }
	.gw-device-check { font-size: 22px; font-weight: 700; }
	.gw-device-divider { position: absolute; left: 0; right: 0; bottom: 0; height: 1px; }

	.gw-quick-grid { flex-direction: row; justify-content: space-between; margin-bottom: 18px; }
	.gw-quick-cell { width: 31%; height: 104px; border-radius: 18px; justify-content: center; align-items: center; }
	.gw-quick-icon { font-size: 28px; margin-bottom: 8px; }
	.gw-quick-label { font-size: 15px; }
	.gw-sheet-list-row { flex-direction: row; align-items: center; height: 60px; }
	.gw-sheet-list-icon { font-size: 21px; width: 36px; }
	.gw-sheet-list-label { font-size: 18px; flex: 1; }
	.gw-sheet-list-chevron { font-size: 23px; }

	.gw-model-list { max-height: 480px; }
	.gw-model-row { flex-direction: row; align-items: center; height: 62px; }
	.gw-model-row-icon { font-size: 21px; width: 36px; }
	.gw-model-row-name { font-size: 18px; margin-right: 8px; }
