<!--
  GWork 首页「任务」（图 75 / 79 / 78 / 82 / 76 / 74）
  ------------------------------------------------------------------
  移植自 mobile/js/app.js 的 renderHome() + renderInput() + popups：
    - 顶部：菜单胶囊 + GWork 标题 + 「☁ 云电脑 >」（图 75）
- 中部：机器人 + 大标题「GWork，我帮你」+ 4 建议胶囊 + 换一换（D5）
    - 底部输入：空闲态单行「发消息或按住说话… + ⊕」；
      激活态（图 79）多行输入 + 模型选择 Hy3 + 发送按钮（D5 两态输入框）
    - 面板：图 74 选择设备 / 图 78 快捷面板 / 图 82 选择模型 / 图 76 侧滑抽屉
  数据来自 common/workbuddy-data.uts（= mobile/js/data.js 的 UTS 翻译）。
  文案、层级与 9 张参考图一致；图标以 Unicode 字形 + view 边框模拟，
  不依赖上游图标组件，避免额外资源 404。
-->
<template>
	<view class="gw-page-root" :style="pageStyle">
		<view class="gw-statusbar"></view>

		<!-- 顶部品牌行（图 75）：菜单按钮 / 标题 / 云电脑 -->
		<view class="gw-home-head">
			<view class="gw-head-menu" :style="themeSurface" @click="onDrawerClick">
				<view class="gw-menu-line" :style="themeText"></view>
				<view class="gw-menu-line" :style="themeText"></view>
			</view>
		<view class="gw-head-title-wrap">
			<view class="gw-head-brand-row">
				<image class="gw-head-brand-logo" :src="brand.logo" mode="aspectFit"></image>
				<text class="gw-head-title" :style="themeText">{{ brand.name }}</text>
			</view>
			<view class="gw-head-sub" @click="onDeviceClick">
					<text class="gw-head-cloud" :style="themeMuted">☁</text>
					<text class="gw-head-sub-text" :style="themeMuted">{{ brand.device }}</text>
					<text class="gw-head-chevron" :style="themeMuted">›</text>
				</view>
			</view>
		</view>

		<!-- 中部主视觉（图 75） -->
		<view class="gw-home-main" :style="pageStyle">
			<image class="gw-home-robot" src="/static/robot.png" mode="aspectFit"></image>
			<text class="gw-home-welcome" :style="themeText">{{ brand.welcome }}</text>

			<view class="gw-home-suggests">
				<view
					class="gw-suggest"
					v-for="(item, index) in visibleSuggestions"
					:key="index"
					:style="themeSurface"
					@click="onSuggestClick(item)"
				>
					<text class="gw-suggest-icon" :style="themeText">{{ item.icon }}</text>
					<text class="gw-suggest-label" :style="themeText">{{ item.label }}</text>
				</view>
			</view>

			<view class="gw-home-refresh" :style="themeSurface2" @click="onRefreshClick">
				<text class="gw-refresh-icon" :style="themeText2">↻</text>
				<text class="gw-refresh-text" :style="themeText2">换一换</text>
			</view>
		</view>

		<!-- 底部输入区（图 75 空闲态 / 图 79 激活态），对应 app.js renderInput() -->
		<view class="gw-home-input-area">
			<view class="gw-input-card" :style="themeSurface" :class="inputActive ? 'gw-input-card-active' : ''">
				<!-- 空闲态：单行 -->
				<view class="gw-input-idle-row" v-if="!inputActive">
					<text class="gw-input-voice" :style="themeText" @click="onVoiceClick">·))</text>
					<textarea
						class="gw-input-idle"
						:style="themeText"
						:placeholder="inputPlaceholder"
						placeholder-class="gw-input-placeholder"
						:auto-height="false"
						@focus="onInputFocus"
						v-model="inputText"
					></textarea>
					<text class="gw-input-plus" :style="themeText" @click="onPlusClick">＋</text>
				</view>

				<!-- 激活态：多行输入 + 模型 + 发送 -->
				<view class="gw-input-active-wrap" v-else>
					<textarea
						class="gw-input-active"
						:style="themeText"
						placeholder="发消息…"
						placeholder-class="gw-input-placeholder"
						:auto-height="false"
						v-model="inputText"
					></textarea>
					<view class="gw-input-toolbar">
						<text class="gw-input-voice" :style="themeText" @click="onVoiceClick">·))</text>
						<view class="gw-model-select" @click="onModelClick">
							<text class="gw-model-dot" :style="themeText">◉</text>
							<text class="gw-model-name" :style="themeText">{{ currentModelName }}</text>
							<text class="gw-model-arrow" :style="themeMuted">⌄</text>
						</view>
						<text class="gw-input-plus" :style="themeText" @click="onPlusClick">＋</text>
						<view class="gw-send-btn" :style="themeSendButton" @click="onSend">
							<text class="gw-send-arrow" :style="'color:' + sendInk">▲</text>
						</view>
					</view>
				</view>
			</view>
			<view class="gw-gesturebar"></view>
		</view>

		<!-- ===== 面板层（图 74 / 76 / 78 / 82），对应 app.js popups ===== -->
		<view class="gw-scrim" :style="themeScrim" v-if="sheetVisible" @click="closeAllSheets"></view>

		<!-- 图 74：选择设备 -->
		<view class="gw-sheet" :style="sheetStyle" v-if="deviceSheetVisible">
			<view class="gw-sheet-head">
				<text class="gw-sheet-title" :style="themeText">选择设备</text>
				<text class="gw-sheet-close" :style="themeMuted" @click="closeAllSheets">×</text>
			</view>
			<view class="gw-sheet-group" :style="themeSurface2">
				<view class="gw-device-row" v-for="(device, index) in devices" :key="device.id">
					<text class="gw-device-icon" :style="themeText">{{ device.id == 'cloud' ? '☁' : '▭' }}</text>
					<text class="gw-device-label" :style="themeText">{{ device.label }}</text>
					<text class="gw-device-offline" :style="themeSurface2" v-if="device.offline">离线</text>
					<text class="gw-device-check" :style="themeAccentText" v-if="device.id == selectedDevice">✓</text>
					<view class="gw-device-divider" :style="themeDivider" v-if="index == 0"></view>
				</view>
			</view>
		</view>

		<!-- 图 78：⊕ 快捷面板 -->
		<view class="gw-sheet" :style="sheetStyle" v-if="quickSheetVisible">
			<view class="gw-quick-grid">
				<view class="gw-quick-cell" :style="themeSurface2" v-for="(action, index) in quickActions" :key="index">
					<text class="gw-quick-icon" :style="themeText">{{ index == 0 ? '⌾' : (index == 1 ? '▧' : '⌁') }}</text>
					<text class="gw-quick-label" :style="themeText">{{ action }}</text>
				</view>
			</view>
			<view class="gw-sheet-list">
				<view class="gw-sheet-list-row" v-for="(row, index) in sheetListRows" :key="index" @click="onQuickRowClick(row)">
					<text class="gw-sheet-list-icon" :style="themeText">{{ ['◉','✦','∞','◷','♩'][index] }}</text>
					<text class="gw-sheet-list-label" :style="themeText">{{ row }}</text>
					<text class="gw-sheet-list-chevron" :style="themeMuted">›</text>
				</view>
			</view>
		</view>

		<!-- 图 82：选择模型 -->
		<view class="gw-sheet" :style="sheetStyle" v-if="modelSheetVisible">
			<view class="gw-sheet-handle" :style="themeSurface2"></view>
			<view class="gw-sheet-head">
				<text class="gw-sheet-title" :style="themeText">选择模型</text>
				<text class="gw-sheet-close" :style="themeMuted" @click="closeAllSheets">×</text>
			</view>
			<scroll-view class="gw-model-list" :scroll-y="true">
				<view class="gw-model-row" v-for="(model, index) in models" :key="model.id" @click="onModelSelect(model.id)">
					<text class="gw-model-row-icon" :style="themeText">{{ ['⚡','◔','◇','◉','◉','✦','Z','Z'][index] }}</text>
					<text class="gw-model-row-name" :style="themeText">{{ model.name }}</text>
					<text class="gw-model-row-free" :style="'background-color:' + dangerTint + ';color:' + dangerInk" v-if="model.free">限时免费</text>
					<text class="gw-model-row-ratio" :style="themeMuted">{{ model.ratio }}</text>
					<text class="gw-model-row-check" :style="themeAccentText" v-if="model.id == selectedModelId">✓</text>
				</view>
			</scroll-view>
		</view>

		<!-- 图 76：侧滑抽屉（复用 mobile/js/app.js 的侧栏结构：云端 ▾ / 新建任务 / 暂无云端任务） -->
		<view class="gw-drawer" :style="themeSurface" v-if="drawerVisible">
			<view class="gw-drawer-head">
				<text class="gw-drawer-cloud" :style="themeText">☁</text>
				<text class="gw-drawer-cloud-label" :style="themeText">云端</text>
				<text class="gw-drawer-arrow" :style="themeText">⌄</text>
			</view>
			<view class="gw-drawer-new" :style="themeSurface" @click="onNewTaskClick">
				<text class="gw-drawer-new-icon" :style="themeText">⊕</text>
				<text class="gw-drawer-new-label" :style="themeText">新建任务</text>
			</view>
			<text class="gw-drawer-empty" :style="themeMuted">暂无云端任务</text>
		</view>
	</view>
</template>

<script lang="uts" setup>
	import { ref, computed } from 'vue'
	import {
		BRAND, SUGGESTIONS, MODELS, DEVICES, QUICK_ACTIONS, SHEET_LIST_ROWS,
		DEFAULT_MODEL_ID,
		type SuggestGroup, type UiModel, type DeviceRow
	} from '@/common/workbuddy-data.uts'
	import {
		rootStyle, surfaceStyle, surface2Style, textStyle, text2Style, mutedStyle,
		dividerStyle, accentTextStyle, sendButtonStyle, tokens, scrimStyle
	} from '@/common/workbuddy-theme.uts'

	const brand = BRAND
	const devices: DeviceRow[] = DEVICES
	const quickActions: string[] = QUICK_ACTIONS
	const sheetListRows: string[] = SHEET_LIST_ROWS
	const models: UiModel[] = MODELS
	const dangerTint: string = '#ffe9e8'
	const dangerInk: string = '#e0574f'
	const inputPlaceholder: string = '发消息或按住说话…'

	// 状态机：对应 app.js DEFAULT_STATE 的 homeSuggestPage / inputActive / selectedModelId 等
	const suggestPage = ref<number>(0)
	const inputActive = ref<boolean>(false)
	const inputText = ref<string>('')
	const selectedModelId = ref<string>(DEFAULT_MODEL_ID)
	const selectedDevice = ref<string>('cloud')
	const drawerVisible = ref<boolean>(false)
	const deviceSheetVisible = ref<boolean>(false)
	const quickSheetVisible = ref<boolean>(false)
	const modelSheetVisible = ref<boolean>(false)

	// :style 绑定的字符串值在 onShow / 主题交互后重算（不使用全局事件总线）
	const pageStyle = ref<string>(rootStyle())
	const surface = ref<string>(surfaceStyle())
	const surface2 = ref<string>(surface2Style())
	const ink = ref<string>(textStyle())
	const ink2 = ref<string>(text2Style())
	const muted = ref<string>(mutedStyle())
	const border = ref<string>(dividerStyle())
	const accentInk = ref<string>(accentTextStyle())
	const sendBtn = ref<string>(sendButtonStyle())
	const scrim = ref<string>(scrimStyle())
	const sendInk = computed<string>(() => tokens().sendInk)

	// uni-app-x 原生渲染的 max-height 只接受 number|px（百分比会编译报错并被丢弃）。
	// H5 契约是 78%（见 mobile/css/app.css 的 .sheet），这里按窗口高度同步换算为 px，
	// 保证不同屏高下底部面板仍受限；模型列表本身是 scroll-view，超高可滚动。
	function sheetMaxHeightPx(): number {
		const h = uni.getWindowInfo().windowHeight
		if (h <= 0) return 560
		return Math.floor(h * 0.78)
	}
	// 返回完整内联样式串（含主题底色 + 动态 max-height），避免模板里拼接多个 ref。
	const sheetStyle = computed<string>(() =>
		surface.value + 'max-height:' + sheetMaxHeightPx() + 'px;')

	function refreshStyles(): void {
		pageStyle.value = rootStyle()
		surface.value = surfaceStyle()
		surface2.value = surface2Style()
		ink.value = textStyle()
		ink2.value = text2Style()
		muted.value = mutedStyle()
		border.value = dividerStyle()
		accentInk.value = accentTextStyle()
		sendBtn.value = sendButtonStyle()
		scrim.value = scrimStyle()
	}
	// 模板统一使用这些响应式别名（名称与 theme helper 区分，避免同名遮蔽）
	const themeSurface = surface
	const themeSurface2 = surface2
	const themeText = ink
	const themeText2 = ink2
	const themeMuted = muted
	const themeDivider = border
	const themeAccentText = accentInk
	const themeSendButton = sendBtn
	const themeScrim = scrim

	// onShow：tab 切换回来 / 主题在「我的」页改动后重读
	onShow(() => {
		refreshStyles()
	})

	const visibleSuggestions = computed<SuggestGroup[]>(() => {
		const start = suggestPage.value * 4
		const result: SuggestGroup[] = []
		for (let i = 0; i < 4; i++) {
			result.push(SUGGESTIONS[start + i]!)
		}
		return result
	})
	const currentModelName = computed<string>(() => {
		for (let i = 0; i < models.length; i++) {
			if (models[i].id == selectedModelId.value) return models[i].name
		}
		return DEFAULT_MODEL_ID
	})
	const sheetVisible = computed<boolean>(() => {
		return deviceSheetVisible.value || quickSheetVisible.value || modelSheetVisible.value
	})

	function closeAllSheets(): void {
		deviceSheetVisible.value = false
		quickSheetVisible.value = false
		modelSheetVisible.value = false
	}
	function onRefreshClick(): void {
		suggestPage.value = (suggestPage.value + 1) % 2
	}
	function onDeviceClick(): void {
		closeAllSheets()
		deviceSheetVisible.value = true
	}
	function onPlusClick(): void {
		closeAllSheets()
		quickSheetVisible.value = true
	}
	function onModelClick(): void {
		closeAllSheets()
		modelSheetVisible.value = true
	}
	function onDrawerClick(): void {
		drawerVisible.value = !drawerVisible.value
	}
	function onNewTaskClick(): void {
		drawerVisible.value = false
		inputActive.value = true
	}
	function onVoiceClick(): void {
		uni.showToast({ title: '语音输入待接入 GWork 内核', icon: 'none' })
	}
	function onInputFocus(): void {
		inputActive.value = true
	}

	function onSuggestClick(item: SuggestGroup): void {
		// TODO(GWork 后端)：把建议词作为首条消息送入 uni-ai-x 流式对话页
		inputText.value = item.label
		inputActive.value = true
	}
	function onSend(): void {
		// TODO(GWork 后端)：接入 uni-ai-x 的 send()/SSE 与会话存储；当前仅清空输入
		if (inputText.value.length == 0) return
		uni.showToast({ title: '对话能力待接入 GWork 内核', icon: 'none' })
		inputText.value = ''
		inputActive.value = false
	}
	function onModelSelect(id: string): void {
		selectedModelId.value = id
		closeAllSheets()
	}
	function onQuickRowClick(row: string): void {
		closeAllSheets()
		if (row == '定时任务') {
			uni.switchTab({ url: '/pages/loop/loop' })
		} else if (row == '专家' || row == '技能' || row == '连接器') {
			uni.switchTab({ url: '/pages/discover/discover' })
		}
	}
</script>

<style lang="scss">
	.gw-home-head {
		flex-direction: row;
		align-items: center;
		padding: 8px $gw-page-pad 0;
		flex-shrink: 0;
	}
