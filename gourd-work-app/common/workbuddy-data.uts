/**
* GWork UI 契约（品牌为 GWork 自有商标）—— UTS 移植版
 * ------------------------------------------------------------
 * 唯一数据基准：gourd-work-app/mobile/js/data.js
 * 本文件只做 UTS 类型化翻译，不新增、不删减任何契约项；
 * 所有 .uvue 页面通过 import { ... } from '@/common/workbuddy-data.uts' 使用。
 * 参考图：workbuddy-images/微信图片_20261103140113_74..82_561.jpg
 */
export type SuggestGroup = {
	label: string,
	icon: string,
	page: number
}

export type DiscoverRow = {
	id: string,
	label: string,
	icon: string,
	group: number
}

export type SettingRow = {
	id: string,
	label: string,
	value: string,
	chevron: boolean,
	toggle: boolean
}

export type DeviceRow = {
	id: string,
	label: string,
	offline: boolean
}

export type UiModel = {
	id: string,
	name: string,
	ratio: string,
	free: boolean
}

export type ThemeOption = {
	id: string,
	label: string
}

export type Brand = {
	name: string,
	device: string,
	welcome: string,
	logo: string
}

