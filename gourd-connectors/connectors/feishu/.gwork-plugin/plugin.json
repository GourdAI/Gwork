{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "feishu",
  "version": "1.0.0",
  "description": "Manage Feishu/Lark products via CLI: IM, Mail, Calendar, Docs, Sheets, Base (Bitable), Slides, Whiteboard, Wiki, Drive, Minutes, VC, Tasks, Approvals, Attendance, Contacts, OKR, and more.",
  "keywords": [
    "cli",
    "skills"
  ],
  "extensions": {
    "cn.gourd.gwork": {
      "schemaVersion": "1.0.0",
      "kind": "cli",
      "tier": "cli",
      "auth": {
        "authType": "cli_login"
      },
      "display": {
        "name": "飞书",
        "name_en": "Feishu",
        "description_zh": "通过命令行管理飞书/Lark 全产品能力：即时通讯、邮箱、日历、云文档、电子表格、多维表格（Base）、幻灯片、画板、知识库、云空间、妙记、视频会议、任务、审批、考勤、通讯录、OKR 等。",
        "description_en": "Manage Feishu/Lark products via CLI: IM, Mail, Calendar, Docs, Sheets, Base (Bitable), Slides, Whiteboard, Wiki, Drive, Minutes, VC, Tasks, Approvals, Attendance, Contacts, OKR, and more."
      },
      "categories": [
        "communication"
      ],
      "source": "vendor-cli:@larksuite/cli@1.0.100",
      "cli_spec": {
        "package": "@larksuite/cli",
        "version": "1.0.100",
        "binName": "lark-cli",
        "binPath": "scripts/run.js",
        "authSteps": [
          {
            "argv": [
              "config",
              "init",
              "--new",
              "--lang",
              "zh"
            ],
            "urlDomain": "open.feishu.cn",
            "waitForExit": true,
            "skipIf": [
              "config",
              "show"
            ]
          },
          {
            "argv": [
              "auth",
              "login",
              "--recommend"
            ],
            "urlDomain": "accounts.feishu.cn",
            "waitForExit": true
          }
        ],
        "status": {
          "argv": [
            "auth",
            "status"
          ],
          "matchJson": {
            "identity": "user"
          }
        },
        "unauth": {
          "argv": [
            "config",
            "remove"
          ]
        }
      },
      "skills": [
        {
          "name": "lark-approval",
          "dir": "skills/lark-approval"
        },
        {
          "name": "lark-apps",
          "dir": "skills/lark-apps"
        },
