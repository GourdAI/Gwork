{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "tencent-docs": {
      "type": "streamable_http",
      "url": "https://docs.qq.com/openapi/mcp",
      "auth": {
        "authType": "qrcode_poll",
        "qrVendor": "tencent-docs",
        "tokenHeader": "Authorization",
