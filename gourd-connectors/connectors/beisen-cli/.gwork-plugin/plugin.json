{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "beisen-cli",
  "version": "1.0.0",
  "description": "Relying on the Beisen HR SaaS platform, we have integrated nearly a hundred HR scenarios—including approvals, recruitment progress, employee profiles, performance records, attendance and leave, organizational structure, and corporate policies—into GWork. This enables you to query HR data and handle HR tasks with just a single sentence.",
  "keywords": [
    "cli",
    "skills"
  ],
  "extensions": {
    "cn.gourd.gwork": {
      "schemaVersion": "1.0.0",
      "kind": "cli",
      "tier": "cli",
      "auth": {
        "authType": "cli_login"
      },
      "display": {
        "name": "北森AI · HR专家",
        "name_en": "Beisen AI·HR Expert",
        "description_zh": "依托北森HR SaaS平台，把审批、招聘进展、员工档案、绩效履历、考勤假期、组织架构和企业制度等近百个人力场景装进GWork，一句话查询人力数据、办理HR业务。",
        "description_en": "Relying on the Beisen HR SaaS platform, we have integrated nearly a hundred HR scenarios—including approvals, recruitment progress, employee profiles, performance records, attendance and leave, organizational structure, and corporate policies—into GWork. This enables you to query HR data and handle HR tasks with just a single sentence."
      },
      "categories": [
        "communication"
      ],
      "source": "vendor-cli:beisen-cli@1.0.10",
      "cli_spec": {
        "package": "beisen-cli",
        "version": "1.0.10",
        "binName": "beisen-cli",
        "binPath": "dist/run.js",
        "auth": {
          "argv": [
            "auth",
            "login"
          ],
          "urlDomain": "login.italent.cn",
          "waitForExit": true
        },
        "status": {
          "argv": [
            "auth",
            "status"
          ],
          "matchJson": {
            "status": "valid"
          }
        },
        "unauth": {
          "argv": [
            "auth",
            "logout"
          ]
        }
      },
