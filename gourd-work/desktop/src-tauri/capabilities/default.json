{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "GWork main window permissions. Covers the local asset origin (tauri.localhost) used by frontendDist.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:app:allow-version",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:event:allow-emit",
    "core:event:allow-emit-to",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-close",
    "core:window:allow-set-title",
    "core:window:allow-set-focus",
    "core:window:allow-minimize",
    "core:window:allow-unminimize",
    "core:window:allow-maximize",
    "core:window:allow-unmaximize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-is-maximized",
    "core:window:allow-is-visible",
    "core:window:allow-start-dragging",
    "core:webview:allow-internal-toggle-devtools",
    "os:default",
    "process:default",
    "shell:allow-open",
    "dialog:default",
    "dialog:allow-open",
    "allow-get-kernel-port",
    "allow-get-kernel-origin",
    "allow-get-workspace",
    "allow-get-app-version",
    "allow-get-backend-state",
    "allow-get-backend-detail",
    "allow-set-window-title",
    "allow-pick-directory",
    "allow-pick-file",
    "allow-window-minimize",
    "allow-window-toggle-maximize",
    "allow-window-close",
    "allow-window-get-chrome",
    "allow-remote-connect",
    "allow-remote-disconnect",
    "allow-remote-reconnect",
    "allow-remote-state",
    "allow-remote-list",
    "allow-remote-forget-host",
    "allow-remote-mirror-sync",
    "allow-remote-bind-scope",
    "allow-remote-wsl-list"
  ]
}
