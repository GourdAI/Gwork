{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GWork",
  "version": "0.3.0",
  "identifier": "com.gourdai.gwork",
  "build": {
    "frontendDist": "../ui",
    "devUrl": "http://127.0.0.1:1420",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "GWork",
    "homepage": "https://gourdwork.com",
    "copyright": "Copyright © 2026 GWork contributors",
    "shortDescription": "GWork 桌面端（Rust 原生内核）",
    "category": "DeveloperTool",
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../build/extraResources/kernels/": "extraResources/kernels/"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese"],
